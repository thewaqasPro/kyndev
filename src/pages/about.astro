---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';

const principles = [
  {
    num: '01',
    title: 'Zero Frame Drops',
    text: 'Every animation and WebGL shader is strictly verified on 60Hz and 120Hz ProMotion displays. If an interaction drops below 58 FPS, it does not ship.'
  },
  {
    num: '02',
    title: 'Island Architecture',
    text: 'By harnessing Astro 5 islands, our pages ship 0kb client-side JavaScript for static editorial sections, reserving memory and GPU cycles strictly for high-fidelity 3D.'
  },
  {
    num: '03',
    title: 'End-to-End Type Safety',
    text: 'From GraphQL schemas and Shopify APIs down to Web Worker message passing and WebGL uniform buffers, strict TypeScript and schema validation eliminate runtime regressions.'
  },
  {
    num: '04',
    title: 'Aggressive Asset Compression',
    text: '3D models undergo automated Draco compression, textures are served in AVIF/KTX2 formats, and font subsets are loaded asynchronously with strict font-display swap.'
  }
];

const teamRoster = [
  { role: 'SYSTEMS & WEBGL LEAD', loc: 'LONDON // UK', focus: 'GLSL Shaders & Three.js Architecture' },
  { role: 'FRONTEND ARCHITECT', loc: 'SAN FRANCISCO // CA', focus: 'Astro, GSAP & Micro-Interactions' },
  { role: 'SHOPIFY PLUS ENGINEER', loc: 'BERLIN // GER', focus: 'Functions, Storefront API & Checkout' },
  { role: 'DISTRIBUTED SYSTEMS ENG', loc: 'TOKYO // JP', focus: 'WebSockets, Go Microservices & Edge CDN' }
];
---

<Layout
  title="STUDIO MANIFESTO & PHILOSOPHY — Lusion Systems"
  description="Our story, core engineering principles, and team ethos dedicated to high-performance systems."
>
  <div class="page-container container">
    <header class="page-header">
      <div class="header-breadcrumbs">
        <a href="/" class="mono-tag" data-cursor="hover">HOME</a>
        <span class="mono-tag cyan">// STUDIO PROFILE</span>
      </div>

      <h1 class="page-title">
        BUILT FOR SPEED. <br />
        <span class="highlight-cyan">DESIGNED TO CAPTIVATE.</span>
      </h1>

      <p class="page-summary">
        We are an independent software and digital architecture collective. We engineer the systems, interfaces, and 3D experiences behind the next generation of industry titans.
      </p>
    </header>

    <!-- Studio Story -->
    <section class="story-section glass-panel">
      <div class="story-header">
        <span class="mono-tag cyan">FOUNDING IMPERATIVE</span>
        <span class="mono-tag">ORIGIN // 2024—2026</span>
      </div>
      <div class="story-body">
        <p class="story-highlight">
          "The modern web settled for mediocrity. Generic frameworks, bloated vendor libraries, and sluggish single-page applications became the default. We founded Lusion Systems to prove that software can be breathtakingly beautiful without sacrificing a single millisecond of execution speed."
        </p>
        <div class="story-columns">
          <p>
            Operating across London, San Francisco, and Tokyo, our team operates at the exact bleeding edge of interactive graphics and enterprise backend infrastructure. We do not maintain account executives or marketing fluff; every client interacts directly with lead software engineers and creative technologists.
          </p>
          <p>
            Whether engineering an institutional financial order-book terminal, launching a high-volume Shopify Plus flagship for Paris Fashion Week, or pioneering procedural WebGL simulations, we approach each project with artisanal precision and uncompromising engineering rigor.
          </p>
        </div>
      </div>
    </section>

    <!-- Engineering Principles -->
    <section class="principles-section">
      <div class="section-title-wrap">
        <span class="mono-tag cyan">UNCOMPROMISING CONTRACTS</span>
        <h2 class="section-title">ENGINEERING PRINCIPLES</h2>
      </div>

      <div class="principles-grid">
        {principles.map((item) => (
          <div class="principle-card glass-panel" data-cursor="hover">
            <span class="principle-num mono-tag">[{item.num}]</span>
            <h3 class="principle-title">{item.title}</h3>
            <p class="principle-text">{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Distributed Engineering Collective -->
    <section class="team-section">
      <div class="section-title-wrap">
        <span class="mono-tag cyan">DISTRIBUTED CORE</span>
        <h2 class="section-title">THE ENGINEERING SQUAD</h2>
      </div>

      <div class="team-grid">
        {teamRoster.map((member) => (
          <div class="team-card glass-panel">
            <span class="mono-tag cyan">{member.role}</span>
            <h3 class="team-location">{member.loc}</h3>
            <p class="team-focus mono-tag">{member.focus}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: calc(var(--header-height) + 3.5rem);
    padding-bottom: 8rem;
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 3.5rem;
  }

  .header-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .highlight-cyan {
    color: var(--accent-cyan);
    text-shadow: 0 0 35px rgba(0, 240, 255, 0.25);
  }

  .page-summary {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--text-secondary);
    max-width: 820px;
    line-height: 1.6;
  }

  .story-section {
    padding: clamp(2.5rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    border-color: rgba(0, 240, 255, 0.15);
  }

  .story-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.25rem;
  }

  .story-highlight {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 2.5rem;
  }

  .story-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .principles-section,
  .team-section {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .section-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .principle-card {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .principle-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .principle-text {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .team-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .team-location {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .team-focus {
    color: var(--text-muted);
  }

  @media (max-width: 800px) {
    .story-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
