---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import AboutWho from '../components/about/AboutWho/AboutWho.astro';
import AboutClients from '../components/about/AboutClients/AboutClients.astro';
import AboutAwards from '../components/about/AboutAwards/AboutAwards.astro';
import AboutCapability from '../components/about/AboutCapability/AboutCapability.astro';
import { aboutMetaData } from '../data/pages/about';
---

<Layout
  title={aboutMetaData.title}
  description={aboutMetaData.description}
  ogUrl={aboutMetaData.ogUrl}
  scrollNavPath={aboutMetaData.scrollNavPath}
  scrollNavText={aboutMetaData.scrollNavText}
>
  <div id="about" class="page">
    <AboutWho />
    <AboutClients />
    <AboutAwards />
    <AboutCapability />
  </div>
</Layout>
