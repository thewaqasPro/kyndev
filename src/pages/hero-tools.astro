---
// src/pages/hero-tools.astro
import Layout from "../layouts/Layout.astro";
import HeroTools from "../components/home/HeroTools/HeroTools.astro";
import Reel from "../components/home/Reel/Reel.astro";
import Featured from "../components/home/Featured/Featured.astro";
import Goal from "../components/home/Goal/Goal.astro";
import { heroToolsMetaData } from "../data/pages/home";
---

<Layout
  title={heroToolsMetaData.title}
  description={heroToolsMetaData.description}
  ogUrl={heroToolsMetaData.ogUrl}
  scrollNavPath={heroToolsMetaData.scrollNavPath}
  scrollNavText={heroToolsMetaData.scrollNavText}
>
  <div id="hero-tools" class="page">
    <HeroTools />
    <Reel />
    <Featured />
    <Goal />
  </div>
</Layout>
