---
// src/pages/projects/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { projectsData } from '../../data/projectsData';
import ProjectDetails from '../../components/projects/ProjectDetails/ProjectDetails.astro';

export async function getStaticPaths() {
  return Object.keys(projectsData).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const project = projectsData[slug as string];

if (!project) {
  return Astro.redirect('/projects');
}

const title = `KYNDEV - ${project.title}`;
const description = `Our detailed case study on ${project.title}. Produced by KYNDEV.`;
const ogUrl = `https://kyndev.com/projects/${project.slug}/`;
---

<Layout
  title={title}
  description={description}
  ogUrl={ogUrl}
  ogTitle={title}
  ogDescription={description}
  scrollNavPath="/projects"
  scrollNavText="All Projects"
>
  <ProjectDetails project={project} />
</Layout>
