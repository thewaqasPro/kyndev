---
// src/pages/projects/index.astro
import Header from '../../components/Header/Header.astro';
import ProjectsGallery from '../../components/ProjectsGallery/ProjectsGallery.astro';
import EndSection from '../../components/EndSection/EndSection.astro';
import Footer from '../../components/Footer/Footer.astro';
import ScrollNav from '../../components/ScrollNav/ScrollNav.astro';
import Overlays from '../../components/Overlays/Overlays.astro';
---

<!DOCTYPE html>
<html lang="en" class="no-js">
  <head>
    <title>KYNDEV - Our Projects</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    <meta name="description" content="KYNDEV works with a wide range of clients including global brands, startups and agencies." />
    <link id="apple-touch-icon" rel="apple-touch-icon" sizes="180x180" href="./assets/meta/apple-touch-icon.png" />
    <link id="icon32" rel="icon" type="image/png" sizes="32x32" href="./assets/meta/favicon-32x32.png" media="(prefers-color-scheme: light)" />
    <link id="icon32" rel="icon" type="image/png" sizes="32x32" href="./assets/meta/dark/favicon-32x32.png" media="(prefers-color-scheme: dark)" />
    <link id="icon64" rel="icon" type="image/png" sizes="16x16" href="./assets/meta/favicon-16x16.png" media="(prefers-color-scheme: light)" />
    <link id="icon64" rel="icon" type="image/png" sizes="16x16" href="./assets/meta/dark/favicon-16x16.png" media="(prefers-color-scheme: dark)" />
    <link href="./assets/meta/favicon.ico" rel="shortcut icon" media="(prefers-color-scheme: light)" />
    <link href="./assets/meta/dark/favicon.ico" rel="shortcut icon" media="(prefers-color-scheme: dark)" />
    <link id="manifest" rel="manifest" href="./assets/meta/site.webmanifest" />
    <link rel="mask-icon" href="./assets/meta/safari-pinned-tab.svg" color="#000000" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:description" content="KYNDEV works with a wide range of clients including global brands, startups and agencies." />
    <meta property="og:image:alt" content="KYNDEV - Our Projects" />
    <meta property="og:image" content="https://kyndev.com/assets/meta/social_sharing.jpg" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="KYNDEV - Our Projects" />
    <meta property="og:title" content="KYNDEV - Our Projects" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kyndev.com/projects/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W2XC5XK9QJ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-W2XC5XK9QJ');
    </script>
    <link rel="stylesheet" href="/_astro/about.CNa9RfUh.css" />
    <script type="module" src="/_astro/hoisted.CUO_IjfL.js"></script>
  </head>
  <body>
    <canvas id="canvas"></canvas>
    <div id="ui">
      <Header />
      <div id="page-container">
        <div id="page-container-inner">
          <ProjectsGallery />
        </div>
        <div id="page-extra-sections">
          <EndSection />
          <Footer />
          <ScrollNav />
        </div>
      </div>
    </div>
    <Overlays />
  </body>
</html>