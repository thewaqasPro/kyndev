---
// src/pages/projects/index.astro
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';

const categories = ['All Disciplines', 'Web Applications', 'Shopify Apps', 'Systems & WebGL', 'Interactive 3D', 'Frontend Architecture'];
---

<Layout
  title="WORK & CASE STUDIES — Lusion Systems"
  description="Proven digital platforms, WebGL engines, and enterprise Shopify Plus architectures."
>
  <div class="page-container container">
    <div class="page-header">
      <div class="header-breadcrumbs">
        <a href="/" class="mono-tag" data-cursor="hover">HOME</a>
        <span class="mono-tag cyan">// WORK INDEX</span>
      </div>

      <h1 class="page-title">
        PRODUCTION <br />
        <span class="highlight-cyan">ARCHITECTURES.</span>
      </h1>

      <p class="page-summary">
        A curated selection of mission-critical systems deployed for global industry leaders — engineered for extreme throughput, zero lag, and flawless visual execution.
      </p>

      <!-- Category Filter Pills -->
      <div class="category-filters">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            class:list={['filter-pill', { active: idx === 0 }]}
            data-filter={cat === 'All Disciplines' ? 'all' : cat}
            data-cursor="hover"
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="projects-list-grid" id="projects-grid">
      {projects.map((project, idx) => (
        <div class="project-item-wrapper" data-category={project.category}>
          <ProjectCard project={project} index={idx} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  // Dynamic Category Filtering
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const projectItems = document.querySelectorAll<HTMLElement>('.project-item-wrapper');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      projectItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        if (filter === 'all' || itemCategory === filter) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .page-container {
    padding-top: calc(var(--header-height) + 3.5rem);
    padding-bottom: 6rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 5rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 3.5rem;
  }

  .header-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .highlight-cyan {
    color: var(--accent-cyan);
    text-shadow: 0 0 35px rgba(0, 240, 255, 0.25);
  }

  .page-summary {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--text-secondary);
    max-width: 820px;
    line-height: 1.6;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .filter-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .filter-pill:hover,
  .filter-pill.active {
    background: rgba(0, 240, 255, 0.1);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .projects-list-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(440px, 1fr));
    gap: 2.5rem;
  }

  @media (max-width: 640px) {
    .projects-list-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
