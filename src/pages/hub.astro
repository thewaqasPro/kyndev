---
// src/pages/hub.astro
import Layout from '../layouts/Layout.astro';
import HubHero from '../components/hub/HubHero.astro';
import HubCards from '../components/hub/HubCards.astro';
import { hubMetaData } from '../data/pages/hub';
---

<Layout
  title={hubMetaData.title}
  description={hubMetaData.description}
  ogUrl={hubMetaData.ogUrl}
  scrollNavPath={hubMetaData.scrollNavPath}
  scrollNavText={hubMetaData.scrollNavText}
  scrollNavSubtitle={hubMetaData.scrollNavSubtitle}
>
  <div id="hub" class="page">
    <HubHero />
    <HubCards />
  </div>
</Layout>
