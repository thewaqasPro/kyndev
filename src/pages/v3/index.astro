---
import { V3_COMPONENTS_REGISTRY } from '../../v3/hub/V3HubRegistry';

const categories = [
  'All',
  '3D Scenic Journeys',
  'Physics & Fluids',
  'Shaders & VFX',
  'Interactive UI',
  'Engine Core'
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kyndev V3 &bull; True 1-to-1 Reverse-Engineering Master Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg-deep: #07080a;
        --bg-panel: #0d0f14;
        --bg-card: #12151c;
        --border-subtle: rgba(255, 255, 255, 0.08);
        --border-glow: rgba(0, 140, 255, 0.35);
        --text-primary: #f0f3f8;
        --text-secondary: #8c97a8;
        --text-dim: #545f73;
        --accent-cyan: #00f0ff;
        --accent-blue: #1a4fff;
        --accent-lime: #a3ff00;
        --accent-amber: #ffaa00;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background: var(--bg-deep);
        color: var(--text-primary);
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      /* Scanline & ambient grid overlay */
      .grid-backdrop {
        position: fixed;
        inset: 0;
        background-image: 
          linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 0;
      }

      header {
        position: relative;
        z-index: 1;
        padding: 4rem 4rem 2rem;
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
      }

      .top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .version-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.78rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--accent-cyan);
        background: rgba(0, 240, 255, 0.08);
        border: 1px solid rgba(0, 240, 255, 0.25);
        padding: 0.45rem 0.9rem;
        border-radius: 9999px;
      }

      .pulse-dot {
        width: 7px;
        height: 7px;
        background: var(--accent-cyan);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--accent-cyan);
        animation: pulse 2s infinite ease-in-out;
      }

      @keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.4); opacity: 0.5; }
      }

      .nav-links {
        display: flex;
        gap: 1.25rem;
        align-items: center;
      }

      .nav-link {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.8rem;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.2s;
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }

      .nav-link:hover {
        color: var(--text-primary);
      }

      h1 {
        font-size: clamp(2.5rem, 5vw, 4.2rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.035em;
        margin: 0 0 1rem;
        background: linear-gradient(180deg, #ffffff 0%, #a8b2c4 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      p.subhead {
        font-size: 1.15rem;
        color: var(--text-secondary);
        max-width: 850px;
        line-height: 1.6;
        margin: 0 0 2rem;
      }

      /* Telemetry HUD Bar */
      .hud-bar {
        position: relative;
        z-index: 1;
        background: var(--bg-panel);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 1.25rem 2rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }

      .hud-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }

      .hud-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-dim);
      }

      .hud-value {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
      }

      .hud-value .accent-cyan { color: var(--accent-cyan); }
      .hud-value .accent-lime { color: var(--accent-lime); }
      .hud-value .accent-amber { color: var(--accent-amber); }

      /* Filter Tabs */
      .filters-container {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
      }

      .filter-btn {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-subtle);
        color: var(--text-secondary);
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.8rem;
        padding: 0.55rem 1.1rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .filter-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-primary);
      }

      .filter-btn.active {
        background: rgba(0, 240, 255, 0.12);
        border-color: rgba(0, 240, 255, 0.4);
        color: var(--accent-cyan);
        font-weight: 600;
      }

      /* Main Grid */
      main {
        position: relative;
        z-index: 1;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 4rem 6rem;
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
        gap: 2rem;
      }

      /* Cards */
      .v3-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 18px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, box-shadow 0.25s;
        position: relative;
        overflow: hidden;
      }

      .v3-card:hover {
        transform: translateY(-4px);
        border-color: var(--border-glow);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 24px rgba(0, 140, 255, 0.12);
      }

      .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
      }

      .cat-pill {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent-cyan);
        background: rgba(0, 240, 255, 0.08);
        border: 1px solid rgba(0, 240, 255, 0.2);
        padding: 0.25rem 0.65rem;
        border-radius: 9999px;
      }

      .source-stamp {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.7rem;
        color: var(--text-dim);
      }

      .v3-card h2 {
        font-size: 1.45rem;
        font-weight: 700;
        margin: 0 0 0.8rem;
        letter-spacing: -0.02em;
        color: #ffffff;
      }

      .v3-card p.desc {
        font-size: 0.92rem;
        color: var(--text-secondary);
        line-height: 1.55;
        margin: 0 0 1.25rem;
      }

      .meta-box {
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      .meta-row {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .meta-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.68rem;
        text-transform: uppercase;
        color: var(--text-dim);
        letter-spacing: 0.05em;
      }

      .meta-content {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.78rem;
        color: #ccd5e3;
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }

      .chip {
        background: rgba(255, 255, 255, 0.06);
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        color: var(--text-primary);
      }

      .chip.shader-chip {
        background: rgba(163, 255, 0, 0.08);
        border: 1px solid rgba(163, 255, 0, 0.25);
        color: var(--accent-lime);
      }

      .key-points {
        margin: 0 0 1.5rem;
        padding-left: 1.2rem;
        font-size: 0.84rem;
        color: var(--text-secondary);
        line-height: 1.5;
      }

      .key-points li {
        margin-bottom: 0.35rem;
      }

      /* Interactive Controls Strip */
      .controls-strip {
        border-top: 1px solid var(--border-subtle);
        padding-top: 1.25rem;
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      .control-title {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        text-transform: uppercase;
        color: var(--text-dim);
        letter-spacing: 0.05em;
        display: flex;
        justify-content: space-between;
      }

      .control-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .control-item span {
        font-size: 0.8rem;
        color: var(--text-secondary);
      }

      .control-item input[type="range"] {
        flex: 1;
        max-width: 140px;
        accent-color: var(--accent-cyan);
      }

      .control-btn {
        background: rgba(0, 140, 255, 0.15);
        border: 1px solid rgba(0, 140, 255, 0.4);
        color: #ffffff;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        padding: 0.35rem 0.8rem;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.2s;
      }

      .control-btn:hover {
        background: rgba(0, 140, 255, 0.3);
      }

      .card-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1rem;
      }

      .action-launch {
        flex: 1;
        background: linear-gradient(90deg, #1a4fff 0%, #0084ff 100%);
        border: none;
        color: #ffffff;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.75rem 1.2rem;
        border-radius: 8px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: opacity 0.2s, transform 0.2s;
      }

      .action-launch:hover {
        opacity: 0.92;
        transform: translateY(-1px);
      }

      @media (max-width: 768px) {
        header { padding: 2.5rem 1.5rem 1rem; }
        main { padding: 0 1.5rem 4rem; grid-template-columns: 1fr; }
        .hud-bar { grid-template-columns: 1fr 1fr; padding: 1.25rem; }
      }
    </style>
  </head>
  <body>
    <div class="grid-backdrop"></div>

    <header>
      <div class="top-row">
        <div class="version-badge">
          <div class="pulse-dot"></div>
          Kyndev V3 &bull; True 1:1 Reverse-Engineering Hub
        </div>
        <div class="nav-links">
          <a href="/preview" class="nav-link">&larr; Legacy V2 Lab</a>
          <a href="/" class="nav-link">Live Production Site (/) &rarr;</a>
        </div>
      </div>

      <h1>Authentic V3 Animation & Scene Hub</h1>
      <p class="subhead">
        Direct, uncompromised 1-to-1 reverse-engineering of all 18 animations, physics solvers, and 46 GLSL shaders from <code>deobfuscated.js</code>. No synthetic approximations or DOM mocks.
      </p>

      <div class="hud-bar">
        <div class="hud-item">
          <span class="hud-label">Authentic Setups</span>
          <span class="hud-value"><span class="accent-cyan">18</span> / 18</span>
        </div>
        <div class="hud-item">
          <span class="hud-label">GLSL Shaders Extracted</span>
          <span class="hud-value"><span class="accent-lime">46</span> Shaders</span>
        </div>
        <div class="hud-item">
          <span class="hud-label">Target FPS / V-Sync</span>
          <span class="hud-value"><span class="accent-cyan">60.0</span> FPS</span>
        </div>
        <div class="hud-item">
          <span class="hud-label">Context Pool Cap</span>
          <span class="hud-value">&le; 4 Active</span>
        </div>
      </div>

      <div class="filters-container" id="filters-container">
        {categories.map((cat, idx) => (
          <button class={`filter-btn ${idx === 0 ? 'active' : ''}`} data-category={cat}>
            {cat}
          </button>
        ))}
      </div>
    </header>

    <main id="components-grid">
      {V3_COMPONENTS_REGISTRY.map((comp) => (
        <div class="v3-card" data-category={comp.category}>
          <div>
            <div class="card-header">
              <span class="cat-pill">{comp.category}</span>
              <span class="source-stamp">{comp.sourceLines}</span>
            </div>

            <h2>{comp.title}</h2>
            <p class="desc">{comp.description}</p>

            <div class="meta-box">
              <div class="meta-row">
                <span class="meta-label">Source Classes</span>
                <div class="meta-content">
                  {comp.sourceClasses.map((cls) => (
                    <span class="chip">{cls}</span>
                  ))}
                </div>
              </div>

              <div class="meta-row">
                <span class="meta-label">Shaders Used</span>
                <div class="meta-content">
                  {comp.shaders.map((sh) => (
                    <span class="chip shader-chip">{sh}</span>
                  ))}
                </div>
              </div>

              <div class="meta-row">
                <span class="meta-label">Assets Required</span>
                <div class="meta-content">
                  {comp.assets.slice(0, 3).map((ast) => (
                    <span class="chip">{ast.split('/').pop()}</span>
                  ))}
                  {comp.assets.length > 3 && (
                    <span class="chip">+{comp.assets.length - 3} more</span>
                  )}
                </div>
              </div>
            </div>

            <ul class="key-points">
              {comp.keyFeatures.map((feat) => (
                <li>{feat}</li>
              ))}
            </ul>
          </div>

          <div class="controls-strip">
            <div class="control-title">
              <span>Simulation & Shader Controls</span>
              <span class="accent-cyan">{comp.badge}</span>
            </div>

            {comp.controls.map((ctrl) => (
              <div class="control-item">
                <span>{ctrl.name}</span>
                {ctrl.type === 'range' && (
                  <input
                    type="range"
                    min={ctrl.min}
                    max={ctrl.max}
                    step={ctrl.step}
                    value={ctrl.default as number}
                  />
                )}
                {ctrl.type === 'button' && (
                  <button class="control-btn">{ctrl.default as string}</button>
                )}
                {ctrl.type === 'toggle' && (
                  <input type="checkbox" checked={ctrl.default as boolean} />
                )}
                {ctrl.type === 'select' && (
                  <span class="chip">{ctrl.default as string}</span>
                )}
              </div>
            ))}

            <div class="card-actions">
              <a href={`/v3/${comp.id}`} class="action-launch">
                Inspect 1:1 Stage &rarr;
              </a>
            </div>
          </div>
        </div>
      ))}
    </main>

    <script>
      // Filter tab interactions
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('.v3-card');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');

          const category = btn.getAttribute('data-category');
          cards.forEach((card) => {
            if (category === 'All' || card.getAttribute('data-category') === category) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // Launch Stage Toast Trigger
      document.querySelectorAll('.action-launch').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          console.log(`[V3 Master Hub] Inspecting Stage: ${id}`);
        });
      });
    </script>
  </body>
</html>
