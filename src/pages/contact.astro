---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { contactMetaData } from '../data/pages/contact';
---

<Layout
  title={contactMetaData.title}
  description={contactMetaData.description}
  ogUrl={contactMetaData.ogUrl}
  scrollNavPath={contactMetaData.scrollNavPath}
  scrollNavText={contactMetaData.scrollNavText}
  scrollNavSubtitle={contactMetaData.scrollNavSubtitle}
>
  <div id="contact" class="page">
    <ContactHero />
    <ContactForm />
  </div>
</Layout>
