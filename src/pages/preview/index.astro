---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kyndev V2 Component Lab & Previews</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #0c0d0e;
        --card-bg: rgba(255, 255, 255, 0.03);
        --card-border: rgba(255, 255, 255, 0.08);
        --text-primary: #ffffff;
        --text-secondary: rgba(255, 255, 255, 0.6);
        --accent: #061dfb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text-primary);
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      header {
        padding: 4rem 4rem 2rem;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
      }

      .badge {
        display: inline-block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #061dfb;
        background: rgba(6, 29, 251, 0.12);
        border: 1px solid rgba(6, 29, 251, 0.3);
        padding: 0.4rem 0.8rem;
        border-radius: 9999px;
        margin-bottom: 1.5rem;
      }

      h1 {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin: 0 0 1rem;
      }

      p.subhead {
        font-size: 1.15rem;
        color: var(--text-secondary);
        max-width: 700px;
        line-height: 1.6;
        margin: 0;
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 4rem 6rem;
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 2rem;
      }

      .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s, background 0.3s;
        text-decoration: none;
        color: inherit;
        position: relative;
        overflow: hidden;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.05);
      }

      .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
      }

      .status-pill {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.7rem;
        padding: 0.3rem 0.75rem;
        border-radius: 9999px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .status-ready {
        background: rgba(173, 255, 0, 0.15);
        color: #adff00;
        border: 1px solid rgba(173, 255, 0, 0.3);
      }

      .status-queued {
        background: rgba(255, 255, 255, 0.06);
        color: var(--text-secondary);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .card h2 {
        font-size: 1.5rem;
        margin: 0 0 1rem;
        letter-spacing: -0.02em;
      }

      .card p {
        font-size: 0.95rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0 0 2rem;
      }

      .tech-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2rem;
      }

      .tag {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.06);
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
      }

      .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
      }

      .cta-link {
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #ffffff;
      }

      .arrow {
        transition: transform 0.2s;
      }

      .card:hover .arrow {
        transform: translateX(4px);
      }

      .original-site-banner {
        margin: 0 4rem 2rem;
        padding: 1.25rem 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1200px;
        align-self: center;
        width: calc(100% - 8rem);
      }

      .original-site-banner span {
        font-size: 0.9rem;
        color: var(--text-secondary);
      }

      .original-site-link {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        color: #ffffff;
        text-decoration: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
      }

      @media (max-width: 768px) {
        header {
          padding: 2.5rem 1.5rem 1rem;
        }
        main {
          padding: 1.5rem 1.5rem 4rem;
          grid-template-columns: 1fr;
        }
        .original-site-banner {
          margin: 0 1.5rem 1rem;
          width: calc(100% - 3rem);
          flex-direction: column;
          gap: 0.75rem;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="badge">Isolated V2 Component Sandbox</div>
      <h1>Modular Component Lab</h1>
      <p class="subhead">
        Independent, modular TypeScript 3D components extracted from the monolithic runtime. The live production site remains 100% untouched.
      </p>
    </header>

    <div class="original-site-banner">
      <span>Production site remains running untouched:</span>
      <a href="/" class="original-site-link">View Live Website (/) &rarr;</a>
    </div>

    <main>
      {components.map((item) => (
        <a href={item.path} class={`card ${item.status === 'Queued' ? 'is-disabled' : ''}`}>
          <div>
            <div class="card-header">
              <span class={`status-pill ${item.status === 'Ready to Preview' ? 'status-ready' : 'status-queued'}`}>
                {item.status}
              </span>
            </div>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </div>

          <div>
            <div class="tech-tags">
              {item.tech.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>

            <div class="card-footer">
              <span class="cta-link">
                {item.status === 'Ready to Preview' ? 'Launch Interactive Preview' : 'In Roadmap'}
                {item.status === 'Ready to Preview' && <span class="arrow">&rarr;</span>}
              </span>
            </div>
          </div>
        </a>
      ))}
    </main>
  </body>
</html>
