---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero/Hero.astro';
import Reel from '../components/home/Reel/Reel.astro';
import Featured from '../components/home/Featured/Featured.astro';
import Goal from '../components/home/Goal/Goal.astro';
import { homeMetaData } from '../data/pages/home';
---

<Layout
  title={homeMetaData.title}
  description={homeMetaData.description}
  ogUrl={homeMetaData.ogUrl}
  scrollNavPath={homeMetaData.scrollNavPath}
  scrollNavText={homeMetaData.scrollNavText}
>
  <div id="home" class="page">
    <Hero />
    <Reel />
    <Featured />
    <Goal />
  </div>
</Layout>
