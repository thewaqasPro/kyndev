---
// src/pages/services.astro
import Layout from '../layouts/Layout.astro';
import ServicesHero from '../components/services/ServicesHero.astro';
import ServicesCapabilitiesShowcase from '../components/services/ServicesCapabilitiesShowcase.astro';
import ServicesList from '../components/services/ServicesList.astro';
import ServicesProcess from '../components/services/ServicesProcess.astro';
import ServicesPhilosophy from '../components/services/ServicesPhilosophy.astro';
---

<Layout
  title="KYNDEV - Our Services"
  description="Responsive web development, UX/UI design, and digital growth services tailored to your goals. No templates, no guesswork."
  ogUrl="https://kyndev.com/services/"
  scrollNavPath="/projects"
  scrollNavText="Our Projects"
  scrollNavSubtitle="Next"
>
  <div id="services" class="page">
    <ServicesHero />
    <ServicesCapabilitiesShowcase />
    <ServicesList />
    <ServicesProcess />
    <ServicesPhilosophy />
  </div>
</Layout>
