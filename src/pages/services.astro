---
// src/pages/services.astro
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';

const processSteps = [
  {
    step: '01',
    title: 'Architectural Deconstruction & Profiling',
    desc: 'We audit bottlenecks, identify critical path latency, and design modular primitives to eliminate unnecessary JS bundles and database roundtrips.'
  },
  {
    step: '02',
    title: 'Shader & Interactive Visual R&D',
    desc: 'For brands demanding visual dominance, our graphics engineers prototype custom Three.js / GLSL shaders, guaranteeing 60fps compositor performance.'
  },
  {
    step: '03',
    title: 'Production Core Systems Build',
    desc: 'Engineering with Astro static islands, typed microservices, and decoupled database schemas designed for horizontal scale and zero downtime.'
  },
  {
    step: '04',
    title: 'Synthetic Stress Testing & Edge Rollout',
    desc: 'Simulating concurrent traffic spikes, verifying Core Web Vitals across low-power mobile devices, and deploying with zero-downtime canary pipelines.'
  }
];
---

<Layout
  title="CORE EXPERTISE & SYSTEMS — KYNDEV"
  description="Technical disciplines: Enterprise Web Applications, Shopify Plus, Headless WordPress, WebGL Systems, and High-Scale APIs."
>
  <div class="page-container container">
    <!-- Header -->
    <header class="page-header">
      <div class="header-breadcrumbs">
        <a href="/" class="mono-tag" data-cursor="hover">HOME</a>
        <span class="mono-tag cyan">// EXPERTISE DIRECTORY</span>
      </div>

      <h1 class="page-title">
        TECHNICAL <br />
        <span class="highlight-cyan">DISCIPLINES.</span>
      </h1>

      <p class="page-summary">
        We specialize in complex, high-throughput digital systems where speed, resilience, and visual prestige are non-negotiable requirements.
      </p>
    </header>

    <!-- Services Detailed Breakdown -->
    <section class="services-detailed-list">
      {services.map((service) => (
        <article class="service-detail-row glass-panel" id={service.id}>
          <div class="service-col-meta">
            <span class="service-num-lg">{service.number}</span>
            <div class="service-badge-group">
              <span class="mono-tag cyan">{service.stats.value} {service.stats.label}</span>
              <span class="mono-tag">READY FOR DEPLOYMENT</span>
            </div>
          </div>

          <div class="service-col-content">
            <h2 class="service-title-lg">{service.title}</h2>
            <p class="service-tagline-quote">"{service.tagline}"</p>
            <p class="service-full-details">{service.details}</p>

            <div class="deliverables-box">
              <span class="deliverables-title mono-tag cyan">ENGINEERING DELIVERABLES</span>
              <div class="deliverables-columns">
                {service.deliverables.map((item) => (
                  <div class="deliv-item">
                    <span class="deliv-bullet">→</span>
                    <span class="deliv-text">{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="service-tech-footer">
              <span class="mono-tag">CORE TECHNOLOGIES:</span>
              <div class="tech-pills">
                {service.techStack.map((tech) => (
                  <span class="tech-pill">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- Engineering Methodology -->
    <section class="methodology-section">
      <div class="section-title-wrap">
        <span class="mono-tag cyan">OPERATIONAL PLAYBOOK</span>
        <h2 class="section-title">THE ENGINEERING PROCESS</h2>
      </div>

      <div class="process-grid">
        {processSteps.map((p) => (
          <div class="process-card glass-panel" data-cursor="hover">
            <span class="process-num mono-tag cyan">PHASE [{p.step}]</span>
            <h3 class="process-title">{p.title}</h3>
            <p class="process-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: calc(var(--header-height) + 3.5rem);
    padding-bottom: 8rem;
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 3.5rem;
  }

  .header-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .highlight-cyan {
    color: var(--accent-cyan);
    text-shadow: 0 0 35px rgba(0, 240, 255, 0.25);
  }

  .page-summary {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--text-secondary);
    max-width: 820px;
    line-height: 1.6;
  }

  /* Services Detailed Breakdown */
  .services-detailed-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .service-detail-row {
    padding: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 4rem;
    align-items: start;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .service-detail-row:hover {
    border-color: rgba(0, 240, 255, 0.3);
  }

  .service-col-meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .service-num-lg {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    font-weight: 800;
    line-height: 0.9;
    color: rgba(255, 255, 255, 0.2);
  }

  .service-badge-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-col-content {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .service-title-lg {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .service-tagline-quote {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
  }

  .service-full-details {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 900px;
  }

  .deliverables-box {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .deliverables-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .deliv-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .deliv-bullet {
    color: var(--accent-cyan);
  }

  .service-tech-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    color: var(--text-secondary);
  }

  /* Methodology */
  .methodology-section {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .section-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .process-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .process-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .process-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .service-detail-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
