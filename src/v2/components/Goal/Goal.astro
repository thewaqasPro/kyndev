---
import './goal.css';

interface Props {
  headline?: string;
  paragraphs?: string[];
}

const {
  headline = 'Where Creative Ideas Become Immersive Experiences',
  paragraphs = [
    'We do not chase trends or produce work that looks like everyone else. We focus on creating visually distinctive digital experiences that reflect your brand, engage your audience, and make people remember what they saw.',
    'Our process blends creative direction, 3D craft, and interactive development to build tailored digital journeys that feel original, polished, and built for impact.',
  ],
} = Astro.props;
---

<section class="v2-goal-root" id="v2-goal-root">
  <div class="goal-inner-wrapper">
    <!-- Header & Manifesto Section -->
    <div class="goal-manifesto-grid">
      <div>
        <span class="goal-badge-pill">Creative Ethos &bull; Kyndev Studio</span>
        <h2 class="goal-headline">{headline}</h2>
      </div>

      <div class="goal-paragraphs-col">
        {paragraphs.map((p, i) => (
          <p class="goal-paragraph">
            {i === 0 ? <strong>{p}</strong> : p}
          </p>
        ))}
      </div>
    </div>

    <!-- Dual Tunnel Portals Section -->
    <div class="goal-portals-section">
      <div class="goal-portals-header">
        <span class="goal-portals-title">Perspective Portals &bull; Interactive Spatial Depth</span>
        <span class="goal-portals-title">[ HOVER TO SHIFT 3D PERSPECTIVE ]</span>
      </div>

      <div class="goal-portals-grid">
        <!-- Portal 1: Entrance -->
        <div class="goal-portal-card" data-portal="entrance">
          <div class="goal-tunnel-bg">
            <div class="tunnel-ring tunnel-ring-1"></div>
            <div class="tunnel-ring tunnel-ring-2"></div>
            <div class="tunnel-ring tunnel-ring-3"></div>
            <div class="tunnel-ring tunnel-ring-4"></div>
          </div>
          <div class="goal-portal-content">
            <span class="goal-portal-step-tag">PORTAL 01 // ENTRY HORIZON</span>
            <h3 class="goal-portal-quote">&ldquo;Step into a new world...&rdquo;</h3>
            <span class="goal-portal-explore-cta">
              Explore Dimension &rarr;
            </span>
          </div>
        </div>

        <!-- Portal 2: Creative World -->
        <div class="goal-portal-card" data-portal="exit">
          <div class="goal-tunnel-bg">
            <div class="tunnel-ring tunnel-ring-1"></div>
            <div class="tunnel-ring tunnel-ring-2"></div>
            <div class="tunnel-ring tunnel-ring-3"></div>
            <div class="tunnel-ring tunnel-ring-4"></div>
          </div>
          <div class="goal-portal-content">
            <span class="goal-portal-step-tag">PORTAL 02 // CREATIVE REACH</span>
            <h3 class="goal-portal-quote">&ldquo;...and let your imagination run wild.&rdquo;</h3>
            <span class="goal-portal-explore-cta">
              Immerse Senses &rarr;
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Ethos Telemetry -->
    <div class="goal-footer-ethos">
      <div>PHILOSOPHY: <span class="goal-ethos-highlight">CRAFT OVER CONVENTION</span></div>
      <div>CORE STACK: <span class="goal-ethos-highlight">BESPOKE WEBGL SHADERS</span></div>
      <div>IMPACT: <span class="goal-ethos-highlight">IMMERSIVE USER ENGAGEMENT</span></div>
    </div>
  </div>
</section>

<script>
  import { GoalController } from './GoalController';

  function initV2Goal() {
    const root = document.getElementById('v2-goal-root');
    if (!root) return;
    const controller = new GoalController();
    controller.init(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initV2Goal);
  } else {
    initV2Goal();
  }
</script>
