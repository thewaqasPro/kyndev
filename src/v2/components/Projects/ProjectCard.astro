---
interface Props {
  slug: string;
  title: string;
  tags: string;
  colorBg?: string;
  colorText?: string;
  colorShadow?: string;
  href?: string;
}

const {
  slug,
  title,
  tags,
  colorBg = '#14161a',
  colorText = '#ffffff',
  colorShadow = 'rgba(0,0,0,0.5)',
  href = `/projects/${slug}`,
} = Astro.props;
---

<a
  class="v2-project-card"
  href={href}
  data-slug={slug}
  data-color-bg={colorBg}
  data-color-text={colorText}
  data-color-shadow={colorShadow}
>
  <div class="v2-card-main">
    <img
      class="v2-card-img"
      src={`/assets/projects/${slug}/home.webp`}
      alt={title}
      loading="lazy"
      decoding="async"
    />
    <canvas class="v2-card-canvas"></canvas>
    <div class="v2-card-shine"></div>
  </div>

  <div class="v2-card-footer">
    <div class="v2-card-tags">{tags}</div>
    <div class="v2-card-title-row">
      <div class="v2-card-title-left">
        <span class="v2-card-dot" style={`background-color: ${colorText}; box-shadow: 0 0 10px ${colorText};`}></span>
        <h3 class="v2-card-title">{title}</h3>
      </div>
      <svg class="v2-card-arrow" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
  </div>
</a>
