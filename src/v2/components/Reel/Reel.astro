---
import './reel.css';

interface Props {
  titleLine1?: string;
  titleLine2?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  vimeoId?: string;
}

const {
  titleLine1 = 'Bold Ideas,',
  titleLine2 = 'Brought to Life',
  description = 'We combine design, motion, 3D, and development to create digital experiences that feel visually striking and technically seamless. From campaign launches to immersive brand worlds, we build work that captures attention and invites interaction.',
  ctaText = 'Our Approach',
  ctaLink = '/about',
  vimeoId = '761102167',
} = Astro.props;

// Split words for 3D kinetic character animations
const line1Words = titleLine1.split(' ');
const line2Words = titleLine2.split(' ');
---

<section class="v2-reel-root" id="v2-reel-root" data-vimeo-id={vimeoId}>
  <div class="reel-inner-wrapper">
    <!-- Header Section -->
    <div class="reel-header-grid">
      <div>
        <span class="reel-badge-tag">Showreel 2026 // Production Highlights</span>
        <h2 class="reel-title" id="home-reel-title">
          <div class="reel-title-line" id="home-reel-title-line-1">
            {line1Words.map((word) => (
              <span class="reel-word">
                {word.split('').map((char) => (
                  <span class="reel-char">{char}</span>
                ))}
              </span>
            ))}
          </div>
          <div class="reel-title-accent reel-title-line">
            {line2Words.map((word) => (
              <span class="reel-word">
                {word.split('').map((char) => (
                  <span class="reel-char">{char}</span>
                ))}
              </span>
            ))}
          </div>
        </h2>
      </div>

      <div class="reel-description-col">
        <p class="reel-description">{description}</p>
        <a href={ctaLink} class="reel-cta-link">
          <span class="reel-cta-dot"></span>
          <span>{ctaText}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 8h11M9 3.5L13.5 8 9 12.5"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Video Stage Card & 3D WebGL Canvas Container -->
    <div class="reel-stage-container" id="home-reel-video-container">
      
      <!-- Top Decorative Strip & Running Marquee -->
      <div class="reel-strip-top" id="home-reel-video-container-top">
        <div class="reel-cross-grid">
          <span class="reel-cross reel-cross-top">+</span>
          <span class="reel-cross reel-cross-top">+</span>
          <span class="reel-cross reel-cross-top">+</span>
          <span class="reel-cross reel-cross-top">+</span>
        </div>
        <div class="reel-ticker-wrapper">
          <div class="reel-ticker-inner reel-ticker-top">
            <span>KYNDEV 3D REEL // 4K DIGITAL MOTION // 60 FPS HDR // SOUND DESIGN BY KYNDEV LABS // </span>
            <span>KYNDEV 3D REEL // 4K DIGITAL MOTION // 60 FPS HDR // SOUND DESIGN BY KYNDEV LABS // </span>
          </div>
        </div>
        <div class="reel-strip-telemetry">
          <span>FPS: <strong class="reel-strip-val">60.0</strong></span>
          <span>RES: <strong class="reel-strip-val">3840×2160</strong></span>
        </div>
      </div>

      <!-- Backdrop Grid / Ambient Light (3D Canvas mounts inside this container) -->
      <div class="reel-poster-backdrop">
        <!-- Interactive Play Reel Button -->
        <button class="reel-watch-btn" type="button" aria-label="Play showreel">
          <div class="reel-btn-orb">
            <div class="reel-btn-ripple"></div>
            <svg class="reel-play-icon" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
          <span class="reel-btn-label">Play Reel</span>
        </button>
      </div>

      <!-- Bottom Decorative Strip & Running Marquee -->
      <div class="reel-strip-bottom" id="home-reel-video-container-bottom">
        <div class="reel-ticker-wrapper">
          <div class="reel-ticker-inner reel-ticker-bottom">
            <span>[ CLICK ORB TO EXPAND FULLSCREEN VIDEO STREAM • PRORES 422 MASTER • VIMEO EMBEDDED ] • </span>
            <span>[ CLICK ORB TO EXPAND FULLSCREEN VIDEO STREAM • PRORES 422 MASTER • VIMEO EMBEDDED ] • </span>
          </div>
        </div>
        <div class="reel-cross-grid">
          <span class="reel-cross reel-cross-bottom">+</span>
          <span class="reel-cross reel-cross-bottom">+</span>
          <span class="reel-cross reel-cross-bottom">+</span>
          <span class="reel-cross reel-cross-bottom">+</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Video Modal Overlay -->
  <div class="reel-video-modal" role="dialog" aria-modal="true" aria-label="Showreel video modal">
    <button class="reel-modal-close-btn" aria-label="Close video modal" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div class="reel-modal-content">
      <iframe
        class="reel-modal-iframe"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        title="Kyndev Showreel"
      ></iframe>
    </div>
  </div>
</section>

<script>
  import { ReelController } from './ReelController';

  function initV2Reel() {
    const root = document.getElementById('v2-reel-root');
    if (!root) return;
    const controller = new ReelController();
    controller.init(root);

    document.addEventListener('astro:before-swap', () => controller.destroy(), { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initV2Reel);
  } else {
    initV2Reel();
  }
</script>
