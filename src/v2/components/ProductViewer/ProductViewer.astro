---
import './productViewer.css';

interface Props {
  initialProduct?: number;
}

const { initialProduct = 0 } = Astro.props;
---

<div class="product-viewer-root" id="product-viewer-root" data-initial-product={initialProduct}>
  <canvas id="product-viewer-canvas" class="product-viewer-canvas"></canvas>

  <!-- Floating Glassmorphic HUD -->
  <div class="viewer-hud">
    <!-- Top Row: Product Info & Prepass Selector -->
    <div class="hud-top-bar">
      <div class="product-info-panel">
        <div class="product-badge-row">
          <span class="inspection-pill">3D Artifact Inspector</span>
          <span class="case-study-tag" id="pv-case-study">Oryzo AI Satirical Campaign</span>
        </div>
        <h2 class="product-title" id="pv-title">Oryzo-1 Neural Coaster</h2>
        <p class="product-tagline" id="pv-tagline">
          Agglomerate Cork with Laser-Etched Neural Circuitry & Gold Inlay
        </p>

        <div class="telemetry-row">
          <div class="telemetry-item">
            <span class="telemetry-label">POLYS:</span>
            <span class="telemetry-val" id="pv-polys">12,544</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">VERTS:</span>
            <span class="telemetry-val" id="pv-verts">6,400</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">DIM:</span>
            <span class="telemetry-val" id="pv-dims">94×94×6.8mm</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">SHADER:</span>
            <span class="telemetry-val" id="pv-shader">PBR BEAUTY</span>
          </div>
        </div>
      </div>

      <!-- Model Prepass Selector -->
      <div class="prepass-mode-selector">
        <button class="prepass-btn is-active" data-prepass="pbr">Beauty (PBR)</button>
        <button class="prepass-btn" data-prepass="normals">Normals</button>
        <button class="prepass-btn" data-prepass="depth">Depth</button>
        <button class="prepass-btn" data-prepass="wireframe">Wireframe</button>
      </div>
    </div>

    <!-- Bottom Row: Studio Tools & Preset Carousel -->
    <div class="hud-bottom-bar">
      <!-- Tool Buttons -->
      <div class="hud-tool-group">
        <button class="hud-btn is-active" id="btn-autorotate" title="Toggle Turntable Rotation">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
          </svg>
          <span>Auto-Spin</span>
        </button>

        <button class="hud-btn" id="btn-lighting" title="Cycle Studio Lighting Mood">
          <span class="mood-dot" id="mood-dot" style="color: #ffffff;"></span>
          <span id="mood-label">Studio</span>
        </button>

        <button class="hud-btn is-active" id="btn-grid" title="Toggle Measurement Grid">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>
          </svg>
          <span>Grid</span>
        </button>

        <button class="hud-btn" id="btn-reset" title="Reset Camera Orientation">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
          <span>Reset</span>
        </button>
      </div>

      <!-- Product Preset Carousel -->
      <div class="preset-carousel">
        <button class="preset-pill is-active" data-index="0">01 ORYZO COASTER</button>
        <button class="preset-pill" data-index="1">02 DREAM MACHINE</button>
        <button class="preset-pill" data-index="2">03 CYBER CROSS</button>
        <button class="preset-pill" data-index="3">04 QUANTUM SPHERE</button>
      </div>

      <!-- Zoom & Orbit Cue -->
      <div class="hud-zoom-group">
        <div class="zoom-controls">
          <button class="zoom-btn" id="btn-zoom-out" title="Zoom Out">&minus;</button>
          <button class="zoom-btn" id="btn-zoom-in" title="Zoom In">&plus;</button>
        </div>
        <div class="orbit-cue">Drag to orbit &bull; Scroll to zoom</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { Engine } from '../../core/Engine';
  import {
    ProductViewerScene,
    type PrepassMode,
    type LightingMood,
    type ProductMetadata
  } from './ProductViewerScene';

  let engine: Engine | null = null;
  let scene: ProductViewerScene | null = null;

  async function initViewer() {
    const canvas = document.getElementById('product-viewer-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    engine = new Engine();
    engine.init(canvas);

    scene = new ProductViewerScene();
    await scene.init();
    scene.attachControls(canvas);

    engine.setStage(scene);
    engine.start();

    // DOM Telemetry elements
    const elTitle = document.getElementById('pv-title');
    const elCaseStudy = document.getElementById('pv-case-study');
    const elTagline = document.getElementById('pv-tagline');
    const elPolys = document.getElementById('pv-polys');
    const elVerts = document.getElementById('pv-verts');
    const elDims = document.getElementById('pv-dims');
    const elShader = document.getElementById('pv-shader');

    // Subscribe to product metadata changes
    scene.onProductChanged = (meta: ProductMetadata) => {
      if (elTitle) elTitle.textContent = meta.name;
      if (elCaseStudy) elCaseStudy.textContent = meta.caseStudy;
      if (elTagline) elTagline.textContent = meta.tagline;
      if (elPolys) elPolys.textContent = meta.polyCount.toLocaleString();
      if (elVerts) elVerts.textContent = meta.vertexCount.toLocaleString();
      if (elDims) elDims.textContent = meta.dimensions;
    };

    // 1. Preset Selector Buttons
    const presetPills = document.querySelectorAll('.preset-pill');
    presetPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const idx = parseInt(pill.getAttribute('data-index') || '0', 10);
        presetPills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        scene?.setProduct(idx);
      });
    });

    const initialIdx = parseInt(document.getElementById('product-viewer-root')?.getAttribute('data-initial-product') || '0', 10);
    if (initialIdx > 0 && initialIdx < presetPills.length) {
      presetPills.forEach((p) => p.classList.remove('is-active'));
      presetPills[initialIdx]?.classList.add('is-active');
      scene.setProduct(initialIdx);
    }

    // 2. Prepass Selector Buttons
    const prepassBtns = document.querySelectorAll('.prepass-btn');
    prepassBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-prepass') as PrepassMode;
        prepassBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        scene?.setPrepassMode(mode);
        if (elShader) elShader.textContent = mode.toUpperCase();
      });
    });

    // 3. Auto-Rotate Toggle
    const btnAutoRotate = document.getElementById('btn-autorotate');
    btnAutoRotate?.addEventListener('click', () => {
      if (!scene?.controls) return;
      const active = scene.controls.toggleAutoRotate();
      btnAutoRotate.classList.toggle('is-active', active);
    });

    // 4. Lighting Mood Cycler
    const moods: LightingMood[] = ['studio', 'neon', 'golden', 'dark'];
    const moodLabels = { studio: 'Studio', neon: 'Cyber Neon', golden: 'Golden Hour', dark: 'Dark Monolith' };
    const moodColors = { studio: '#ffffff', neon: '#00f0ff', golden: '#ff9944', dark: '#38bdf8' };
    let currentMoodIdx = 0;

    const btnLighting = document.getElementById('btn-lighting');
    const moodDot = document.getElementById('mood-dot');
    const moodLabel = document.getElementById('mood-label');

    btnLighting?.addEventListener('click', () => {
      currentMoodIdx = (currentMoodIdx + 1) % moods.length;
      const m = moods[currentMoodIdx];
      scene?.setLightingMood(m);
      if (moodLabel) moodLabel.textContent = moodLabels[m];
      if (moodDot) {
        moodDot.style.color = moodColors[m];
        moodDot.style.background = moodColors[m];
      }
    });

    // 5. Grid Toggle
    const btnGrid = document.getElementById('btn-grid');
    btnGrid?.addEventListener('click', () => {
      const isVisible = scene?.toggleGrid() ?? false;
      btnGrid.classList.toggle('is-active', isVisible);
    });

    // 6. Camera Reset
    const btnReset = document.getElementById('btn-reset');
    btnReset?.addEventListener('click', () => {
      scene?.controls?.resetView(true);
    });

    // 7. Zoom Buttons
    document.getElementById('btn-zoom-in')?.addEventListener('click', () => {
      scene?.controls?.zoomIn(0.5);
    });
    document.getElementById('btn-zoom-out')?.addEventListener('click', () => {
      scene?.controls?.zoomOut(0.5);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initViewer);
  } else {
    initViewer();
  }
</script>
