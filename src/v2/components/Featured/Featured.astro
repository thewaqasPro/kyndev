---

<section class="v2-featured-root" id="v2-featured-root">
  <div class="featured-inner-wrapper">
    <!-- Header Row -->
    <div class="featured-header-row">
      <div>
        <span class="featured-badge-pill">Curated Portfolio // 2024 &ndash; 2026</span>
        <h2 class="featured-headline">FEATURED WORK</h2>
      </div>

      <div class="featured-disclaimer">
        Selected projects spanning WebGL, immersive 3D, and digital campaigns.
      </div>
    </div>

    <!-- Filter Strip -->
    <div class="featured-filter-strip">
      <button class="featured-filter-pill is-active" data-filter="all">All Projects (09)</button>
      <button class="featured-filter-pill" data-filter="3d">3D &bull; Animation</button>
      <button class="featured-filter-pill" data-filter="development">WebGL &bull; Dev</button>
      <button class="featured-filter-pill" data-filter="concept">Concept &bull; Design</button>
    </div>

    <!-- Project List -->
    <div class="featured-project-list">
      {projects.map((proj) => (
        <a
          href={proj.href}
          class="featured-project-row"
          data-id={proj.id}
          data-title={proj.title}
          data-tags={proj.tags}
          data-bg={proj.colorBg}
          data-text={proj.colorText}
          data-thumb={proj.thumb}
        >
          <div class="featured-row-left">
            <span class="featured-index">{proj.index}</span>
            <div class="featured-title-wrap">
              <h3 class="featured-project-title">{proj.title}</h3>
              <span class="featured-project-tags">{proj.tags}</span>
            </div>
          </div>

          <div class="featured-row-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- Footer Telemetry -->
    <div class="featured-footer-telemetry">
      <div>TOTAL WORK: <span class="featured-footer-highlight">09 CASE STUDIES</span></div>
      <div>RECOGNITION: <span class="featured-footer-highlight">58+ GLOBAL AWARDS</span></div>
      <div>ENGINE: <span class="featured-footer-highlight">KYNDEV V2 MODULAR</span></div>
    </div>
  </div>

  <!-- Floating Cursor 2.5D Shader Preview Card -->
  <div class="featured-floating-preview" aria-hidden="true">
    <div class="featured-preview-img-wrap">
      <canvas class="featured-shader-canvas"></canvas>
    </div>
    <div class="featured-preview-title"></div>
    <div class="featured-preview-tags"></div>
  </div>
</section>

<script>
  import { FeaturedController } from './FeaturedController';

  function initV2Featured() {
    const root = document.getElementById('v2-featured-root');
    if (!root) return;
    const controller = new FeaturedController();
    controller.init(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initV2Featured);
  } else {
    initV2Featured();
  }
</script>
