---
interface Props {
  title?: string;
  tagline?: string;
}

const {
  title = "We create 3D visual storytelling and interactive web experiences that help brands stand out",
  tagline = "KYNDEV V2 MODULAR SYSTEM"
} = Astro.props;
---

<section class="v2-hero-container">
  <div class="v2-hero-canvas-wrap">
    <canvas id="v2-hero-canvas"></canvas>
  </div>

  <div class="v2-hero-ui">
    <div class="v2-hero-badge">{tagline}</div>
    <h1 class="v2-hero-title">{title}</h1>
    <div class="v2-hero-controls">
      <span class="v2-hero-hint">Hover to push &bull; Click to scatter and cycle colors</span>
      <button id="v2-hero-color-btn" class="v2-color-pill" type="button">Change Palette</button>
    </div>
  </div>
</section>

<style>
  .v2-hero-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
    background: #0b0c0e;
    color: #ffffff;
    font-family: 'Space Grotesk', -apple-system, sans-serif;
  }

  .v2-hero-canvas-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    overflow: hidden;
  }

  #v2-hero-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .v2-hero-ui {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem 3rem;
    box-sizing: border-box;
  }

  .v2-hero-badge {
    align-self: flex-start;
    font-size: 0.8rem;
    font-family: 'IBM Plex Mono', monospace;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    pointer-events: auto;
  }

  .v2-hero-title {
    max-width: 900px;
    font-size: clamp(2rem, 4.5vw, 4.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    user-select: none;
    pointer-events: none;
  }

  .v2-hero-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .v2-hero-hint {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.05em;
  }

  .v2-color-pill {
    pointer-events: auto;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.75rem 1.5rem;
    background: #ffffff;
    color: #0c0d0e;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
  }

  .v2-color-pill:hover {
    transform: scale(1.05);
    background: #e5e5e5;
  }

  .v2-color-pill:active {
    transform: scale(0.96);
  }

  @media (max-width: 768px) {
    .v2-hero-ui {
      padding: 2rem 1.5rem;
    }
    .v2-hero-controls {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>

<script>
  import { Engine } from '../../core/Engine';
  import { HeroScene } from './HeroScene';

  function initHero() {
    const canvas = document.getElementById('v2-hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const engine = new Engine();
    engine.init(canvas);

    const scene = new HeroScene();
    scene.init().then(() => {
      engine.setStage(scene);
      engine.start();
    });

    const colorBtn = document.getElementById('v2-hero-color-btn');
    if (colorBtn) {
      colorBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        scene.onPointerClick();
      });
    }

    const container = document.querySelector('.v2-hero-container');
    if (container) {
      container.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('#v2-hero-color-btn')) return;
        scene.onPointerClick();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
