---
export interface Props {
  defaultPreset?: string;
}

const { defaultPreset = 'line_goal' } = Astro.props;
---

<div class="spline-ribbon-container">
  <canvas id="spline-ribbon-canvas"></canvas>

  <div class="ribbon-hud">
    <div class="hud-header">
      <span class="badge">Universal Spline Ribbon (Line & UfxMesh)</span>
      <span class="status-dot">Live Shaders: vert$j & frag$m</span>
    </div>

    <div class="hud-controls">
      <div class="control-row">
        <label for="preset-select">Curve Preset:</label>
        <select id="preset-select">
          <option value="line_goal" selected={defaultPreset === 'line_goal'}>line_goal.buf (Goal Ribbon)</option>
          <option value="line_reel" selected={defaultPreset === 'line_reel'}>line_reel.buf (Reel Path)</option>
          <option value="line_capability" selected={defaultPreset === 'line_capability'}>line_capability.buf (Capabilities)</option>
          <option value="line_office" selected={defaultPreset === 'line_office'}>line_office.buf (Office Path)</option>
        </select>
      </div>

      <div class="control-row">
        <label for="progress-slider">Reveal Progress (u_showRatio):</label>
        <input type="range" id="progress-slider" min="0" max="1" step="0.005" value="0.85" />
        <span id="progress-val" class="val">85%</span>
      </div>

      <div class="control-row">
        <label for="radius-slider">Tube Radius (u_radius):</label>
        <input type="range" id="radius-slider" min="0.5" max="6" step="0.1" value="1.8" />
        <span id="radius-val" class="val">1.8px</span>
      </div>

      <div class="control-row">
        <button id="toggle-anim-btn" class="action-btn">Pause Auto-Scrub</button>
      </div>
    </div>
  </div>
</div>

<style>
  .spline-ribbon-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 600px;
    background: #090a0d;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ribbon-hud {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(13, 16, 22, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 18px 24px;
    color: #ffffff;
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    z-index: 10;
  }

  .hud-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #00f0ff;
    background: rgba(0, 240, 255, 0.12);
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .status-dot {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    color: #8c97a8;
  }

  .hud-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    align-items: center;
  }

  .control-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: #a8b2c4;
  }

  .control-row select {
    background: #181c24;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 6px 10px;
    border-radius: 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
  }

  .control-row input[type="range"] {
    flex: 1;
    accent-color: #00f0ff;
  }

  .val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: #00f0ff;
    min-width: 45px;
  }

  .action-btn {
    background: rgba(0, 240, 255, 0.15);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: #00f0ff;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
    transition: background 0.2s;
  }

  .action-btn:hover {
    background: rgba(0, 240, 255, 0.25);
  }
</style>

<script>
  import * as THREE from 'three';
  import { Engine } from '../../core/Engine';
  import { Stage3D } from '../../core/Stage3D';
  import { SplineRibbon, SPLINE_LINES_DATA } from '../../core/SplineRibbon';

  class RibbonScene extends Stage3D {
    public activeRibbon: SplineRibbon | null = null;
    public currentPreset: string = 'line_goal';
    public isAutoAnimating: boolean = true;
    public progress: number = 0.85;

    public async init(): Promise<void> {
      this.camera.position.set(0, 0, 2);
      this.camera.lookAt(0, 0, 0);

      await this.loadPreset(this.currentPreset);
    }

    public async loadPreset(name: string): Promise<void> {
      if (this.activeRibbon) {
        this.scene.remove(this.activeRibbon.mesh!);
        this.activeRibbon.destroy();
        this.activeRibbon = null;
      }

      const cfg = SPLINE_LINES_DATA.find((item) => item.fileName === name) || SPLINE_LINES_DATA[0];
      this.currentPreset = cfg.fileName;
      this.activeRibbon = new SplineRibbon(cfg);

      const mesh = await this.activeRibbon.init();
      this.scene.add(mesh);

      // Fit camera to bounding box
      const box = new THREE.Box3(cfg.boxMin, cfg.boxMax);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      this.camera.position.set(center.x, center.y, Math.max(size.x, size.y) * 1.2 + 0.5);
      this.camera.lookAt(center);
    }

    public update(_delta: number, time: number): void {
      if (this.isAutoAnimating) {
        this.progress = (Math.sin(time * 0.8) * 0.5 + 0.5);
        const slider = document.getElementById('progress-slider') as HTMLInputElement;
        const valSpan = document.getElementById('progress-val');
        if (slider && valSpan) {
          slider.value = this.progress.toFixed(3);
          valSpan.textContent = `${Math.round(this.progress * 100)}%`;
        }
      }

      if (this.activeRibbon) {
        this.activeRibbon.update(this.progress, time);
      }
    }

    public resize(width: number, height: number): void {
      this.camera.aspect = width / height;
      this.camera.updateProjectionMatrix();
      if (this.activeRibbon) {
        this.activeRibbon.resize(width, height);
      }
    }

    public destroy(): void {
      if (this.activeRibbon) {
        this.activeRibbon.destroy();
      }
    }
  }

  const canvas = document.getElementById('spline-ribbon-canvas') as HTMLCanvasElement;
  if (canvas) {
    const engine = new Engine();
    engine.init(canvas);

    const scene = new RibbonScene();
    scene.init().then(() => {
      engine.setStage(scene);
      engine.start();
    });

    // Preset selector
    const presetSelect = document.getElementById('preset-select') as HTMLSelectElement;
    presetSelect?.addEventListener('change', () => {
      scene.loadPreset(presetSelect.value);
    });

    // Progress slider
    const progressSlider = document.getElementById('progress-slider') as HTMLInputElement;
    const progressVal = document.getElementById('progress-val');
    progressSlider?.addEventListener('input', () => {
      scene.isAutoAnimating = false;
      scene.progress = parseFloat(progressSlider.value);
      if (progressVal) progressVal.textContent = `${Math.round(scene.progress * 100)}%`;
      const animBtn = document.getElementById('toggle-anim-btn');
      if (animBtn) animBtn.textContent = 'Resume Auto-Scrub';
    });

    // Radius slider
    const radiusSlider = document.getElementById('radius-slider') as HTMLInputElement;
    const radiusVal = document.getElementById('radius-val');
    radiusSlider?.addEventListener('input', () => {
      const rad = parseFloat(radiusSlider.value);
      if (scene.activeRibbon) scene.activeRibbon.uniforms.u_radius.value = rad;
      if (radiusVal) radiusVal.textContent = `${rad.toFixed(1)}px`;
    });

    // Auto-anim button
    const animBtn = document.getElementById('toggle-anim-btn');
    animBtn?.addEventListener('click', () => {
      scene.isAutoAnimating = !scene.isAutoAnimating;
      animBtn.textContent = scene.isAutoAnimating ? 'Pause Auto-Scrub' : 'Resume Auto-Scrub';
    });
  }
</script>
