---
---

<div class="product-viewer-container" id="product-viewer-container">
  <canvas id="product-viewer-canvas"></canvas>

  <div class="viewer-hud">
    <div class="hud-header">
      <span class="badge">3D Product Inspection Studio</span>
      <span class="status-dot">ProjectDetailsScreen &bull; vert$b & frag$f &bull; OrbitControls</span>
    </div>

    <div class="hud-controls">
      <div class="control-row">
        <label for="model-select">Product Model:</label>
        <select id="model-select">
          <option value="/assets/models/home/cross.buf">Cyber Cross (.buf)</option>
          <option value="/assets/models/plant.buf">Organic Plant (.buf)</option>
        </select>
      </div>

      <div class="control-row">
        <label for="speed-slider">Auto-Turntable Speed:</label>
        <input type="range" id="speed-slider" min="0" max="4" step="0.2" value="1.0" />
        <span id="speed-val" class="val">1.0x</span>
      </div>

      <div class="control-row">
        <label for="rim-slider">Studio Rim Light:</label>
        <input type="range" id="rim-slider" min="0" max="5" step="0.2" value="2.5" />
        <span id="rim-val" class="val">2.5</span>
      </div>

      <div class="control-row">
        <button id="reset-cam-btn" class="action-btn">Reset Inspection Camera</button>
      </div>
    </div>
  </div>
</div>

<style>
  .product-viewer-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 600px;
    background: radial-gradient(circle at 50% 40%, #151822 0%, #06070a 80%);
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }

  canvas:active {
    cursor: grabbing;
  }

  .viewer-hud {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(13, 16, 22, 0.88);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 18px 24px;
    color: #ffffff;
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    z-index: 10;
  }

  .hud-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #00f0ff;
    background: rgba(0, 240, 255, 0.12);
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .status-dot {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    color: #8c97a8;
  }

  .hud-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    align-items: center;
  }

  .control-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: #a8b2c4;
  }

  .control-row select {
    background: #181c24;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 6px 10px;
    border-radius: 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
  }

  .control-row input[type="range"] {
    flex: 1;
    accent-color: #00f0ff;
  }

  .val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: #00f0ff;
    min-width: 45px;
  }

  .action-btn {
    background: rgba(0, 240, 255, 0.15);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: #00f0ff;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>

<script>
  import * as THREE from 'three';
  import { BufLoader } from '../../core/BufLoader';

  const container = document.getElementById('product-viewer-container');
  const canvas = document.getElementById('product-viewer-canvas') as HTMLCanvasElement;

  if (container && canvas) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, 1.2, 3.8);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance'
    });

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);

    // Studio Lighting
    const amb = new THREE.AmbientLight(0xffffff, 1.0);
    scene.add(amb);

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
    keyLight.position.set(3, 5, 4);
    scene.add(keyLight);

    const rimLight = new THREE.DirectionalLight(0x00f0ff, 2.5);
    rimLight.position.set(-4, -2, -3);
    scene.add(rimLight);

    let activeMesh: THREE.Mesh | null = null;
    let autoRotateSpeed = 1.0;

    const loadModel = async (url: string) => {
      if (activeMesh) {
        scene.remove(activeMesh);
        activeMesh.geometry.dispose();
      }

      const geometry = await BufLoader.load(url);
      geometry.center();

      const mat = new THREE.MeshPhysicalMaterial({
        color: new THREE.Color('#e0e6ed'),
        roughness: 0.2,
        metalness: 0.85,
        clearcoat: 1.0,
        clearcoatRoughness: 0.1
      });

      activeMesh = new THREE.Mesh(geometry, mat);
      scene.add(activeMesh);
    };

    loadModel('/assets/models/home/cross.buf');

    // Drag rotation controls
    let isDragging = false;
    let prevX = 0;
    let prevY = 0;
    let rotX = 0;
    let rotY = 0;

    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      prevX = e.clientX;
      prevY = e.clientY;
    });

    window.addEventListener('mouseup', () => (isDragging = false));

    window.addEventListener('mousemove', (e) => {
      if (!isDragging || !activeMesh) return;
      const deltaX = e.clientX - prevX;
      const deltaY = e.clientY - prevY;
      prevX = e.clientX;
      prevY = e.clientY;

      rotY += deltaX * 0.008;
      rotX += deltaY * 0.008;
      rotX = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, rotX));
    });

    const resize = () => {
      const rect = container.getBoundingClientRect();
      camera.aspect = rect.width / rect.height;
      camera.updateProjectionMatrix();
      renderer.setSize(rect.width, rect.height, false);
    };

    resize();
    window.addEventListener('resize', resize);

    let lastTime = performance.now();
    const tick = (now: number) => {
      const delta = (now - lastTime) * 0.001;
      lastTime = now;

      if (activeMesh) {
        if (!isDragging) {
          rotY += autoRotateSpeed * delta * 0.6;
        }
        activeMesh.rotation.y = rotY;
        activeMesh.rotation.x = rotX;
      }

      camera.lookAt(0, 0, 0);
      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);

    // Controls
    const modelSelect = document.getElementById('model-select') as HTMLSelectElement;
    modelSelect?.addEventListener('change', () => {
      loadModel(modelSelect.value);
    });

    const speedSlider = document.getElementById('speed-slider') as HTMLInputElement;
    const speedVal = document.getElementById('speed-val');
    speedSlider?.addEventListener('input', () => {
      autoRotateSpeed = parseFloat(speedSlider.value);
      if (speedVal) speedVal.textContent = `${autoRotateSpeed.toFixed(1)}x`;
    });

    const rimSlider = document.getElementById('rim-slider') as HTMLInputElement;
    const rimVal = document.getElementById('rim-val');
    rimSlider?.addEventListener('input', () => {
      const rim = parseFloat(rimSlider.value);
      rimLight.intensity = rim;
      if (rimVal) rimVal.textContent = rim.toFixed(1);
    });

    const resetBtn = document.getElementById('reset-cam-btn');
    resetBtn?.addEventListener('click', () => {
      rotX = 0;
      rotY = 0;
      camera.position.set(0, 1.2, 3.8);
    });
  }
</script>
