---
---

<div class="hero-balloons-container" id="hero-balloons-container">
  <canvas id="hero-balloons-canvas"></canvas>

  <div class="hero-hud">
    <div class="hud-header">
      <span class="badge">3D Jacks Rigid Body Physics</span>
      <span class="status-dot">HomeBalloons &bull; cross.buf &bull; matcap.exr</span>
    </div>

    <div class="hud-controls">
      <div class="control-row">
        <label for="repulsion-slider">Repulsion Force:</label>
        <input type="range" id="repulsion-slider" min="1" max="15" step="0.5" value="5.5" />
        <span id="repulsion-val" class="val">5.5</span>
      </div>

      <div class="control-row">
        <label for="palette-select">Color Palette:</label>
        <select id="palette-select">
          <option value="0">Electric Blue / Ice</option>
          <option value="1">Neon Lime / Acid</option>
          <option value="2">Cyber Magenta / Violet</option>
          <option value="3">Solar Amber / Gold</option>
        </select>
      </div>

      <div class="control-row">
        <button id="jostle-btn" class="action-btn">Impulse Push All Bodies</button>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-balloons-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 600px;
    background: #06070a;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-hud {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(13, 16, 22, 0.88);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 18px 24px;
    color: #ffffff;
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    z-index: 10;
  }

  .hud-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #00f0ff;
    background: rgba(0, 240, 255, 0.12);
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .status-dot {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    color: #8c97a8;
  }

  .hud-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    align-items: center;
  }

  .control-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: #a8b2c4;
  }

  .control-row select {
    background: #181c24;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 6px 10px;
    border-radius: 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
  }

  .control-row input[type="range"] {
    flex: 1;
    accent-color: #00f0ff;
  }

  .val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: #00f0ff;
    min-width: 45px;
  }

  .action-btn {
    background: rgba(0, 240, 255, 0.15);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: #00f0ff;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>

<script>
  import * as THREE from 'three';
  import { BufLoader } from '../../core/BufLoader';

  const container = document.getElementById('hero-balloons-container');
  const canvas = document.getElementById('hero-balloons-canvas') as HTMLCanvasElement;

  if (container && canvas) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
    camera.position.set(0, 0, 8);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance'
    });

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);

    const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0x00f0ff, 2.5);
    dirLight.position.set(5, 10, 7);
    scene.add(dirLight);

    const PALETTES = [
      ['#0029ff', '#00f0ff', '#1a3fff', '#ffffff'],
      ['#a3ff00', '#00ffaa', '#22bb33', '#ffffff'],
      ['#bb2bff', '#ff00aa', '#6600cc', '#ffffff'],
      ['#ffaa00', '#ff4400', '#ffcc00', '#ffffff']
    ];
    let currentPaletteIdx = 0;

    interface BalloonBody {
      mesh: THREE.Mesh;
      position: THREE.Vector3;
      velocity: THREE.Vector3;
      rotationVel: THREE.Vector3;
      baseScale: number;
    }

    const bodies: BalloonBody[] = [];
    let repulsionStrength = 5.5;

    BufLoader.load('/assets/models/home/cross.buf').then((geometry) => {
      geometry.center();

      const numBodies = 30;
      for (let i = 0; i < numBodies; i++) {
        const pal = PALETTES[currentPaletteIdx];
        const color = new THREE.Color(pal[i % pal.length]);

        const mat = new THREE.MeshPhysicalMaterial({
          color,
          roughness: 0.15,
          metalness: 0.85,
          clearcoat: 1.0,
          clearcoatRoughness: 0.1
        });

        const mesh = new THREE.Mesh(geometry, mat);
        const scale = 0.5 + Math.random() * 0.4;
        mesh.scale.setScalar(scale);

        const pos = new THREE.Vector3(
          (Math.random() - 0.5) * 6,
          (Math.random() - 0.5) * 4,
          (Math.random() - 0.5) * 2
        );
        mesh.position.copy(pos);

        scene.add(mesh);
        bodies.push({
          mesh,
          position: pos,
          velocity: new THREE.Vector3((Math.random() - 0.5) * 0.5, (Math.random() - 0.5) * 0.5, 0),
          rotationVel: new THREE.Vector3((Math.random() - 0.5) * 1.5, (Math.random() - 0.5) * 1.5, 0),
          baseScale: scale
        });
      }
    });

    const pointer = new THREE.Vector2(-999, -999);
    container.addEventListener('mousemove', (e) => {
      const rect = container.getBoundingClientRect();
      pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
    });

    const resize = () => {
      const rect = container.getBoundingClientRect();
      camera.aspect = rect.width / rect.height;
      camera.updateProjectionMatrix();
      renderer.setSize(rect.width, rect.height, false);
    };

    resize();
    window.addEventListener('resize', resize);

    let lastTime = performance.now();
    const tick = (now: number) => {
      const delta = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      // Pointer 3D ray position
      const rayPointer = new THREE.Vector3(pointer.x * 4.5, pointer.y * 3.0, 0);

      for (const b of bodies) {
        // Pointer repulsion
        const toPointer = b.position.clone().sub(rayPointer);
        const dist = toPointer.length();
        if (dist < 3.0 && dist > 0.01) {
          const force = (1.0 - dist / 3.0) * repulsionStrength;
          b.velocity.add(toPointer.normalize().multiplyScalar(force * delta));
        }

        // Damping and spring back toward center
        b.velocity.add(b.position.clone().multiplyScalar(-0.4 * delta));
        b.velocity.multiplyScalar(0.96);

        // Position integration
        b.position.add(b.velocity.clone().multiplyScalar(delta));
        b.mesh.position.copy(b.position);

        // Rotation integration
        b.mesh.rotation.x += b.rotationVel.x * delta;
        b.mesh.rotation.y += b.rotationVel.y * delta;
      }

      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);

    // Controls
    const repSlider = document.getElementById('repulsion-slider') as HTMLInputElement;
    const repVal = document.getElementById('repulsion-val');
    repSlider?.addEventListener('input', () => {
      repulsionStrength = parseFloat(repSlider.value);
      if (repVal) repVal.textContent = repSlider.value;
    });

    const palSelect = document.getElementById('palette-select') as HTMLSelectElement;
    palSelect?.addEventListener('change', () => {
      currentPaletteIdx = parseInt(palSelect.value);
      const pal = PALETTES[currentPaletteIdx];
      bodies.forEach((b, idx) => {
        const mat = b.mesh.material as THREE.MeshPhysicalMaterial;
        mat.color.set(pal[idx % pal.length]);
      });
    });

    const pushBtn = document.getElementById('jostle-btn');
    pushBtn?.addEventListener('click', () => {
      for (const b of bodies) {
        b.velocity.set(
          (Math.random() - 0.5) * 8,
          (Math.random() - 0.5) * 8,
          (Math.random() - 0.5) * 4
        );
      }
    });
  }
</script>
