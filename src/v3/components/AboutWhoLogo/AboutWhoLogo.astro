---
---

<div class="about-who-logo-container" id="about-who-logo-container">
  <canvas id="about-who-logo-canvas"></canvas>

  <div class="logo-hud">
    <div class="hud-header">
      <span class="badge">About Who 3D Wireframe Logo</span>
      <span class="status-dot">Shaders: vert$1 & frag$4 &bull; logo_text.buf</span>
    </div>

    <div class="hud-controls">
      <div class="control-row">
        <label for="logo-show-slider">Show Ratio (u_showRatio):</label>
        <input type="range" id="logo-show-slider" min="0" max="1" step="0.01" value="1.0" />
        <span id="logo-show-val" class="val">100%</span>
      </div>

      <div class="control-row">
        <label for="logo-hide-slider">Hide Ratio (u_hideRatio):</label>
        <input type="range" id="logo-hide-slider" min="0" max="1" step="0.01" value="0.0" />
        <span id="logo-hide-val" class="val">0%</span>
      </div>

      <div class="control-row">
        <button id="toggle-logo-anim" class="action-btn">Toggle Auto-Morph</button>
      </div>
    </div>
  </div>
</div>

<style>
  .about-who-logo-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 600px;
    background: #08090c;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .logo-hud {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(13, 16, 22, 0.88);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 18px 24px;
    color: #ffffff;
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    z-index: 10;
  }

  .hud-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #00f0ff;
    background: rgba(0, 240, 255, 0.12);
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .status-dot {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    color: #8c97a8;
  }

  .hud-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    align-items: center;
  }

  .control-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: #a8b2c4;
  }

  .control-row input[type="range"] {
    flex: 1;
    accent-color: #00f0ff;
  }

  .val {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    color: #00f0ff;
    min-width: 45px;
  }

  .action-btn {
    background: rgba(0, 240, 255, 0.15);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: #00f0ff;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>

<script>
  import * as THREE from 'three';
  import { BufLoader } from '../../core/BufLoader';

  const container = document.getElementById('about-who-logo-container');
  const canvas = document.getElementById('about-who-logo-canvas') as HTMLCanvasElement;

  if (container && canvas) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
    camera.position.set(0, 0, 3.5);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance'
    });

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);

    let logoMesh: THREE.Mesh | null = null;
    let isAutoAnimating = true;

    const uniforms = {
      u_time: { value: 0 },
      u_showRatio: { value: 1.0 },
      u_hideRatio: { value: 0.0 },
      u_aspect: { value: 1 / 0.200957 }
    };

    // Shaders vert$1 and frag$4
    const vert1 = `
      varying float v_dist;
      uniform float u_showRatio;
      uniform float u_hideRatio;
      uniform float u_time;
      
      void main() {
        v_dist = position.z;
        vec3 pos = position;
        
        // Dynamic morphing
        float show = smoothstep(0.0, 1.0, u_showRatio);
        pos.xy *= show;
        
        // Gentle wave oscillation
        pos.z += sin(pos.x * 4.0 + u_time * 2.0) * 0.05 * (1.0 - u_hideRatio);
        
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `;

    const frag4 = `
      varying float v_dist;
      void main() {
        float alpha = smoothstep(0.0, 0.0 + fwidth(v_dist), abs(v_dist) + 0.1);
        vec3 neonColor = mix(vec3(0.0, 0.94, 1.0), vec3(1.0, 1.0, 1.0), v_dist * 2.0);
        gl_FragColor = vec4(neonColor, alpha);
      }
    `;

    const material = new THREE.ShaderMaterial({
      vertexShader: vert1,
      fragmentShader: frag4,
      uniforms,
      transparent: true,
      side: THREE.DoubleSide
    });

    BufLoader.load('/assets/models/about/logo_text.buf').then((geometry) => {
      geometry.center();
      logoMesh = new THREE.Mesh(geometry, material);
      logoMesh.scale.setScalar(2.0);
      scene.add(logoMesh);
    });

    const resize = () => {
      const rect = container.getBoundingClientRect();
      camera.aspect = rect.width / rect.height;
      camera.updateProjectionMatrix();
      renderer.setSize(rect.width, rect.height, false);
    };

    resize();
    window.addEventListener('resize', resize);

    // tick
    const tick = (now: number) => {
      /* delta */
      

      uniforms.u_time.value = now * 0.001;

      if (logoMesh) {
        logoMesh.rotation.y = Math.sin(now * 0.0008) * 0.4;
        logoMesh.rotation.x = Math.cos(now * 0.0005) * 0.15;
      }

      if (isAutoAnimating) {
        uniforms.u_showRatio.value = Math.sin(now * 0.0015) * 0.35 + 0.65;
        const slider = document.getElementById('logo-show-slider') as HTMLInputElement;
        const valSpan = document.getElementById('logo-show-val');
        if (slider && valSpan) {
          slider.value = uniforms.u_showRatio.value.toFixed(2);
          valSpan.textContent = `${Math.round(uniforms.u_showRatio.value * 100)}%`;
        }
      }

      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);

    // Controls
    const showSlider = document.getElementById('logo-show-slider') as HTMLInputElement;
    const showVal = document.getElementById('logo-show-val');
    showSlider?.addEventListener('input', () => {
      isAutoAnimating = false;
      uniforms.u_showRatio.value = parseFloat(showSlider.value);
      if (showVal) showVal.textContent = `${Math.round(uniforms.u_showRatio.value * 100)}%`;
    });

    const hideSlider = document.getElementById('logo-hide-slider') as HTMLInputElement;
    const hideVal = document.getElementById('logo-hide-val');
    hideSlider?.addEventListener('input', () => {
      uniforms.u_hideRatio.value = parseFloat(hideSlider.value);
      if (hideVal) hideVal.textContent = `${Math.round(uniforms.u_hideRatio.value * 100)}%`;
    });

    const toggleBtn = document.getElementById('toggle-logo-anim');
    toggleBtn?.addEventListener('click', () => {
      isAutoAnimating = !isAutoAnimating;
      toggleBtn.textContent = isAutoAnimating ? 'Pause Auto-Morph' : 'Resume Auto-Morph';
    });
  }
</script>
