---
// src/components/ProjectDetails/ProjectMediaGallery.astro
import type { ProjectItem } from '../../data/projectsData';

interface Props {
  items: ProjectItem[];
}

const { items } = Astro.props;
---

<div id="project-details-items-wrapper">
  <div id="project-details-items-move-container">
    {items.map((item) => (
      <div
        class={`project-details-item is-${item.type}`}
        data-width={item.width}
        data-height={item.height}
        data-filename={item.filename}
        data-type={item.type}
        data-fullscreen={item.fullscreen ? '' : undefined}
      />
    ))}
  </div>
</div>
