---
// src/components/ProjectDetails/ProjectNextPreview.astro
import type { NextProjectPreview } from '../../../data/projectsData';

interface Props {
  nextProject: NextProjectPreview;
}

const { nextProject } = Astro.props;
---

<div
  id="project-details-preview"
  data-next-id={nextProject.id}
  data-next-color-bg={nextProject.colorBg}
  data-next-color-text={nextProject.colorText}
  data-next-shadow={nextProject.shadow}
>
  <div id="project-details-preview-inner">
    <h2 id="project-details-preview-title">{nextProject.title}</h2>
    <div id="project-details-preview-footer">
      <div id="project-details-preview-footer-text">NEXT PROJECT</div>
      <div id="project-details-preview-footer-bar">
        <div id="project-details-preview-footer-bar-background"></div>
        <div id="project-details-preview-footer-bar-inner"></div>
      </div>
      <svg id="project-details-preview-footer-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="none">
        <path stroke="#000" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 8h12m0 0-5.865 6M14 8 8.135 2"></path>
      </svg>
    </div>
  </div>
</div>
