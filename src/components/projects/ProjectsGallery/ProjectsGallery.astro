---
// src/components/ProjectsGallery/ProjectsGallery.astro
import './projectsGallery.css';
import ProjectGalleryCard from './ProjectGalleryCard.astro';
import { projectsList } from '../../../data/projectsData';
---

<div id="projects" class="page">
  <div id="projects-main" class="section">
    <div id="projects-main-title-top">
      <div id="projects-main-title-wrapper">
        <h4 id="projects-main-title">PROJECTS</h4>
        <span id="projects-main-title-project-number">{projectsList.length}</span>
        <svg
          id="projects-main-title-project-arrow"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 38 38"
          width="38"
          height="38"
          fill="none"
        >
          <path
            stroke="#000"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m2 2 34 34m0 0V6.046M36 36H6.046"
          ></path>
        </svg>
      </div>
    </div>
    <div class="project-list">
      {projectsList.map((project) => (
        <ProjectGalleryCard
          slug={project.slug}
          title={project.title}
          tags={project.tags}
          colorBg={project.theme.colorBg}
          colorText={project.theme.colorText}
          colorShadow={project.theme.shadow}
        />
      ))}
    </div>
  </div>
</div>

<script>
  import { initProjectsGallery } from './ProjectsGallery.ts';
  initProjectsGallery();
</script>
