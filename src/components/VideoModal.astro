---
// src/components/VideoModal.astro
---

<div id="video-overlay" role="dialog" aria-modal="true" aria-label="Case Study Video Player">
  <div class="video-modal-header">
    <div class="video-modal-meta">
      <span class="mono-tag cyan" id="modal-video-client">CLIENT</span>
      <h3 class="video-modal-title" id="modal-video-title">CASE STUDY REEL</h3>
    </div>

    <button id="video-modal-close" class="hud-btn" data-cursor="hover" aria-label="Close video player">
      <span>CLOSE [ ESC ]</span>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <div class="video-modal-viewport">
    <!-- Synthesized ambient motion canvas or MP4 stream reel -->
    <video 
      id="modal-video-element" 
      playsinline 
      loop 
      preload="metadata"
      poster="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1920' height='1080' viewBox='0 0 1920 1080'><rect width='1920' height='1080' fill='%230a0a0f'/><text x='50%25' y='50%25' fill='%2300f0ff' font-family='monospace' font-size='24' text-anchor='middle'>// LIVE CASE STUDY REEL STREAM</text></svg>"
    >
      <source src="https://assets.codepen.io/32795/ambient-loop.mp4" type="video/mp4" />
    </video>

    <!-- Synthetic Graphic Overlay HUD inside Video -->
    <div class="video-inner-hud">
      <span class="hud-tag">4K PRORES // 60FPS</span>
      <span class="hud-tag cyan">AUDIO: SYNTHETIC STEREO</span>
    </div>
  </div>

  <div class="video-modal-controls">
    <div class="video-timeline" id="modal-timeline">
      <div class="video-timeline-fill" id="modal-progress-fill"></div>
    </div>

    <div class="video-control-buttons">
      <div class="controls-left">
        <button id="modal-play-toggle" class="hud-btn" data-cursor="hover">
          <span>PAUSE</span>
        </button>
        <button id="modal-mute-toggle" class="hud-btn" data-cursor="hover">
          <span>MUTE</span>
        </button>
      </div>

      <div class="controls-center">
        <span class="mono-tag" id="modal-timecode">00:00 / 02:00</span>
      </div>

      <div class="controls-right">
        <span class="mono-tag cyan">COMPOSITOR BITRATE: 48 MBPS</span>
      </div>
    </div>
  </div>
</div>

<style>
  .video-modal-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .video-modal-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .video-inner-hud {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .hud-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.3rem 0.6rem;
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    letter-spacing: 0.1em;
  }

  .hud-tag.cyan {
    color: var(--accent-cyan);
    border-color: rgba(0, 240, 255, 0.3);
  }

  .controls-left,
  .controls-center,
  .controls-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .controls-right {
      display: none;
    }
  }
</style>
