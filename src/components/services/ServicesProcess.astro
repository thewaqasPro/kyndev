---
// src/components/services/ServicesProcess.astro
import './servicesProcess.css';
import {
  servicesProcessData,
  type ServicesProcessData,
  type ProcessStep,
} from '../../data/pages/services';

export type { ProcessStep };

export interface Props extends Partial<ServicesProcessData> {}

const {
  eyebrow = servicesProcessData.eyebrow,
  title = servicesProcessData.title,
  steps = servicesProcessData.steps,
} = Astro.props;
---

<div id="services-process" class="section">
  <div id="services-process-header">
    <div id="services-process-eyebrow">{eyebrow}</div>
    <h2 id="services-process-title">{title}</h2>
  </div>

  {steps.map((step) => (
    <div class="services-process-step">
      <div class="services-process-num">{step.num}</div>
      <h3 class="services-process-step-title">{step.title}</h3>
      <p class="services-process-step-desc">{step.desc}</p>
    </div>
  ))}
</div>
