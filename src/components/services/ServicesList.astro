---
// src/components/services/ServicesList.astro
import './servicesList.css';
import { servicesData } from '../../data/servicesData';

const services = Object.values(servicesData);
---

<div id="services-list" class="section">
  {services.map((service) => (
    <a href={`/services/${service.slug}`} class="services-list-card">
      <div class="services-card-top">
        <div class="services-card-header">
          <span class="services-card-num">{service.number} //</span>
          <span class="services-card-badge">{service.category}</span>
        </div>
        <h2 class="services-card-title">{service.title}</h2>
        <p class="services-card-desc">{service.description}</p>
      </div>

      <div class="services-card-bottom">
        <div class="services-card-tags">
          {service.capabilities.slice(0, 3).map((cap) => (
            <span class="services-card-tag">{cap.title}</span>
          ))}
        </div>
        <div class="services-card-cta">
          <span>Explore Capability</span>
          <span class="services-card-arrow">→</span>
        </div>
      </div>
    </a>
  ))}
</div>
