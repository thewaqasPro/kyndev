---
// src/components/services/ServicesPhilosophy.astro
import './servicesShowcase.css';
import {
  servicesPhilosophyData,
  type ServicesPhilosophyData,
  type PhilosophyValue,
} from '../../data/pages/services';

export type { PhilosophyValue };

export interface Props extends Partial<ServicesPhilosophyData> {}

const {
  tag = servicesPhilosophyData.tag,
  title = servicesPhilosophyData.title,
  values = servicesPhilosophyData.values,
} = Astro.props;
---

<div id="services-philosophy" class="section services-philosophy-section">
  <div class="services-philosophy-header">
    <div class="services-philosophy-tag">{tag}</div>
    <h2 class="services-philosophy-title">{title}</h2>
  </div>

  <div class="services-philosophy-grid">
    {values.map((val) => (
      <div class="services-philosophy-card">
        <div class="philosophy-card-icon">{val.icon}</div>
        <h3 class="philosophy-card-heading">{val.title}</h3>
        <p class="philosophy-card-text">{val.text}</p>
      </div>
    ))}
  </div>
</div>
