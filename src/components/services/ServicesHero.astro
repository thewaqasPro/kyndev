---
// src/components/services/ServicesHero.astro
import './servicesHero.css';
import { servicesHeroData, type ServicesHeroData } from '../../data/pages/services';

export interface Props extends Partial<ServicesHeroData> {}

const {
  eyebrow = servicesHeroData.eyebrow,
  title = servicesHeroData.title,
  description = servicesHeroData.description,
} = Astro.props;
---

<div id="services-hero" class="section">
  <div class="services-hero-crosses">
    <div class="services-hero-cross"></div>
    <div class="services-hero-cross"></div>
  </div>

  <div id="services-hero-eyebrow">
    <span class="dot"></span>
    <span>{eyebrow}</span>
  </div>

  <h1 id="services-hero-title">{title}</h1>
  <p id="services-hero-desc">{description}</p>
</div>
