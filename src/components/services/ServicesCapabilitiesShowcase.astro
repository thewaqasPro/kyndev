---
// src/components/services/ServicesCapabilitiesShowcase.astro
import './servicesShowcase.css';
import {
  servicesCapabilitiesShowcaseData,
  type ServicesCapabilitiesShowcaseData,
  type CapabilityPillar,
} from '../../data/pages/services';

export type { CapabilityPillar };

export interface Props extends Partial<ServicesCapabilitiesShowcaseData> {}

const {
  tag = servicesCapabilitiesShowcaseData.tag,
  title = servicesCapabilitiesShowcaseData.title,
  pillars = servicesCapabilitiesShowcaseData.pillars,
} = Astro.props;
---

<div id="services-showcase" class="section services-showcase-section">
  <div class="services-showcase-header">
    <div class="services-showcase-tag">{tag}</div>
    <h2 class="services-showcase-title">{title}</h2>
  </div>

  <div class="services-showcase-grid">
    {pillars.map((pillar) => (
      <div class="services-showcase-card">
        <div class="showcase-card-num">{pillar.num} // PILLAR</div>
        <h3 class="showcase-card-title">{pillar.title}</h3>
        <p class="showcase-card-desc">{pillar.desc}</p>
        <div class="showcase-card-tags">
          {pillar.tags.map((t) => (
            <span class="showcase-card-tag">{t}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
