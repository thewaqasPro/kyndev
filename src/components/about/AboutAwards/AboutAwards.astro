---
// src/components/about/AboutAwards/AboutAwards.astro
import './aboutAwards.css';
import AboutAwardsTitleSvg from './AboutAwardsTitleSvg.astro';
import { aboutAwardsData, type AboutAwardsData } from '../../../data/pages/about';

export interface Props extends Partial<AboutAwardsData> {}

const {
  awardsCategory = aboutAwardsData.awardsCategory,
  articlesCategory = aboutAwardsData.articlesCategory,
  talksCategory = aboutAwardsData.talksCategory,
} = Astro.props;
---

<div id="about-award" class="section">
  <div class="about-award-category award-category-awards">
    <div class="about-award-header">
      <h5 class="about-award-header-title">{awardsCategory.title}</h5>
      <div class="about-award-header-number">
        <svg
          class="about-award-header-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="37"
          fill="none"
          viewBox="0 0 36 37"
        >
          <path
            fill="#fff"
            d="M15.189 1.678a3.976 3.976 0 0 1 6.624 3.939L18 18.514 14.187 5.617a3.976 3.976 0 0 1 1.002-3.939Z"
          ></path>
          <path
            fill="#fff"
            d="M27.916 4.621a3.976 3.976 0 0 1 1.9 7.47L18 18.513l6.423-11.816a3.976 3.976 0 0 1 3.494-2.077ZM34.836 15.702a3.976 3.976 0 0 1-3.94 6.624L18 18.514 30.897 14.7a3.976 3.976 0 0 1 3.939 1.001Z"
          ></path>
          <path
            fill="#fff"
            d="M31.892 28.43a3.976 3.976 0 0 1-7.469 1.9L18 18.513l11.816 6.423a3.976 3.976 0 0 1 2.076 3.493ZM20.811 35.35a3.976 3.976 0 0 1-6.624-3.94L18 18.514l3.813 12.896a3.976 3.976 0 0 1-1.002 3.94ZM8.083 32.406a3.976 3.976 0 0 1-1.899-7.469L18 18.514l-6.423 11.815a3.976 3.976 0 0 1-3.494 2.077ZM1.165 21.325a3.976 3.976 0 0 1 3.938-6.624L18 18.514 5.103 22.327a3.976 3.976 0 0 1-3.938-1.002ZM4.108 8.597a3.976 3.976 0 0 1 7.469-1.899L18 18.514 6.184 12.09a3.976 3.976 0 0 1-2.076-3.493Z"
          ></path>
        </svg>
        <p class="about-award-header-text">{awardsCategory.totalCount}</p>
      </div>
    </div>
    {awardsCategory.groups.map((group) => (
      <div class="about-award-item">
        {group.items.map((item, idx) => (
          <div class="about-award-item-wrapper">
            <p class="about-award-item-wrapper-text">{idx === 0 ? group.organization : ''}</p>
            <p class="about-award-item-wrapper-text">{item.count}</p>
            <p class="about-award-item-wrapper-text">{item.label}</p>
          </div>
        ))}
        <div class="about-award-line"></div>
      </div>
    ))}
  </div>
  <div class="about-award-category award-category-articles">
    <div class="about-award-header">
      <h5 class="about-award-header-title">{articlesCategory.title}</h5>
      <div class="about-award-header-number">
        <svg
          class="about-award-header-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="37"
          fill="none"
          viewBox="0 0 36 37"
        >
          <path
            fill="#fff"
            d="M0 18.277c0-.663.456-1.236 1.092-1.426A22.73 22.73 0 0 0 16.337 1.605C16.527.97 17.1.514 17.764.514h.472c.664 0 1.237.455 1.427 1.091a22.73 22.73 0 0 0 15.245 15.246c.636.19 1.092.763 1.092 1.427v.472c0 .663-.456 1.237-1.092 1.426a22.73 22.73 0 0 0-15.245 15.246c-.19.636-.763 1.092-1.427 1.092h-.472c-.664 0-1.237-.456-1.427-1.092A22.73 22.73 0 0 0 1.092 20.176C.456 19.986 0 19.414 0 18.75v-.473Z"
          ></path>
        </svg>
        <p class="about-award-header-text">{articlesCategory.totalCount}</p>
      </div>
    </div>
    <div class="about-award-item">
      <div class="about-award-item-wrapper">
        {articlesCategory.articles.map((article) => (
          <div class="about-award-item-container">
            <svg
              class="about-award-item-wrapper-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 17"
              width="16"
              height="17"
              fill="none"
            >
              <path
                fill="#fff"
                fill-rule="evenodd"
                d="M2.3 15.586a.75.75 0 1 1-1.06-1.06L12.418 3.347H4.261a.75.75 0 1 1 0-1.5h10.715v10.715a.75.75 0 1 1-1.5 0V4.41L2.3 15.586Z"
                clip-rule="evenodd"
              ></path>
            </svg>{' '}
            <a
              class="about-award-item-wrapper-text"
              target="_blank"
              href={article.href}
            >
              {article.title}
            </a>
          </div>
        ))}
      </div>
      <div class="about-award-line"></div>
    </div>
  </div>
  <div class="about-award-category award-category-talks">
    <div class="about-award-header">
      <h5 class="about-award-header-title">{talksCategory.title}</h5>
      <div class="about-award-header-number">
        <svg
          class="about-award-header-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="37"
          fill="none"
          viewBox="0 0 36 37"
        >
          <path
            fill="#fff"
            fill-rule="evenodd"
            d="M0 5.07a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Zm13.5 0a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Zm18-4.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9ZM0 18.57a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Zm18-4.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Zm9 4.5a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Zm-22.5 9a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Zm9 4.5a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Zm18-4.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z"
            clip-rule="evenodd"
          ></path>
        </svg>
        <p class="about-award-header-text">{talksCategory.totalCount}</p>
      </div>
    </div>
    <div class="about-award-item">
      {talksCategory.talks.map((talk) => (
        <div class="about-award-item-wrapper --old">
          <div class="about-award-item-container">
            <svg
              class="about-award-item-wrapper-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 17"
              width="16"
              height="17"
              fill="none"
            >
              <path
                fill="#fff"
                fill-rule="evenodd"
                d="M2.3 15.586a.75.75 0 1 1-1.06-1.06L12.418 3.347H4.261a.75.75 0 1 1 0-1.5h10.715v10.715a.75.75 0 1 1-1.5 0V4.41L2.3 15.586Z"
                clip-rule="evenodd"
              ></path>
            </svg>{' '}
            <a class="about-award-item-wrapper-text">{talk.event}</a>
          </div>
          <div class="about-award-item-container">
            <p class="about-award-item-wrapper-text">{talk.dateLocation}</p>
          </div>
        </div>
      ))}
      <div class="about-award-line"></div>
    </div>
  </div>
  <AboutAwardsTitleSvg />
</div>

<script>
  import { initAboutAwards } from './AboutAwards.ts';
  initAboutAwards();
</script>
