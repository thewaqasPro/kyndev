---
// src/components/about/AboutCapability/AboutCapability.astro
import './aboutCapability.css';
import {
  aboutCapabilityData,
  type AboutCapabilityData,
  type CapabilityCard,
} from '../../../data/pages/about';

export type { CapabilityCard };

export interface Props extends Partial<AboutCapabilityData> {}

const {
  titleLines = aboutCapabilityData.titleLines,
  subheaderText = aboutCapabilityData.subheaderText,
  subheaderCards = aboutCapabilityData.subheaderCards,
  capabilities = aboutCapabilityData.capabilities,
} = Astro.props;
---

<div id="about-capability" class="section">
  <div id="about-capability-title">
    <div id="about-capability-title-line-1">{titleLines[0]}</div>
    <div id="about-capability-title-line-2">{titleLines[1]}</div>
  </div>
  <div id="about-capability-subheader">
    <div id="about-capability-subheader-text">
      {subheaderText}
    </div>
    <div id="about-capability-subheader-cards">
      {subheaderCards.map((card) => (
        <div class="about-capability-subheader-card">{card}</div>
      ))}
    </div>
  </div>
  <div id="about-capability-cards-wrapper">
    <div id="about-capability-cards">
      {capabilities.map((cap, index) => (
        <div class="about-capability-card">
          {index === 0 ? (
            <>
              <div class="about-capability-card-front">
                <div class="about-capability-card-header">
                  <p class="about-capability-card-header-text">{cap.title}</p>
                  <div class="about-capability-card-header-letter">{cap.letter}</div>
                </div>
                <ul class="about-capability-list">
                  {cap.items.map((item) => (
                    <li class="about-capability-list-item">{item}</li>
                  ))}
                </ul>
                <div class="about-capability-card-header">
                  <p class="about-capability-card-header-text">{cap.title}</p>
                  <div class="about-capability-card-header-letter">{cap.letter}</div>
                </div>
              </div>
              <div class="about-capability-card-back"></div>
            </>
          ) : (
            <>
              <div class="about-capability-card-back"></div>
              <div class="about-capability-card-front">
                <div class="about-capability-card-header">
                  <p class="about-capability-card-header-text">{cap.title}</p>
                  <div class="about-capability-card-header-letter">{cap.letter}</div>
                </div>
                <ul class="about-capability-list">
                  {cap.items.map((item) => (
                    <li class="about-capability-list-item">{item}</li>
                  ))}
                </ul>
                <div class="about-capability-card-header">
                  <p class="about-capability-card-header-text">{cap.title}</p>
                  <div class="about-capability-card-header-letter">{cap.letter}</div>
                </div>
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import { initAboutCapability } from './AboutCapability.ts';
  initAboutCapability();
</script>
