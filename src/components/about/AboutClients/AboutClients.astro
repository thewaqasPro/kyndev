---
// src/components/about/AboutClients/AboutClients.astro
import './aboutClients.css';
import { aboutClientsData, type AboutClientsData } from '../../../data/pages/about';

export interface Props extends Partial<AboutClientsData> {}

const {
  title = aboutClientsData.title,
  description = aboutClientsData.description,
  carouselRows = aboutClientsData.carouselRows,
} = Astro.props;
---

<div id="about-clients" class="section">
  <div id="about-clients-header">
    <div id="about-clients-title">{title}</div>
    <div id="about-clients-desc">{description}</div>
  </div>
  <div id="about-clients-carousel">
    {carouselRows.map((row) => (
      <div class="about-clients-carousel-line">
        {row.map((logo) => (
          <img src={logo.src} alt={logo.alt} />
        ))}
      </div>
    ))}
  </div>
</div>

<script>
  import { initAboutClients } from './AboutClients.ts';
  initAboutClients();
</script>
