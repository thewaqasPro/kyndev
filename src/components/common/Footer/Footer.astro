---
import './footer.css';
import { footerData, type FooterData } from '../../../data/common/footer';

export interface Props {
  addressLines?: string[];
  mapsUrl?: string;
  emailGeneral?: string;
  emailBusiness?: string;
  copyright?: string;
  tagline?: string;
}

const {
  addressLines = footerData.addressLines,
  mapsUrl = footerData.mapsUrl,
  emailGeneral = footerData.emailGeneral,
  emailBusiness = footerData.emailBusiness,
  copyright = footerData.copyright,
  tagline = footerData.tagline,
} = Astro.props;
---

<div id="footer-section" class="section">
  <div id="footer-bg"></div>
  <div id="footer-top"></div>
  <div id="footer-middle">
    <div id="footer-middle-contact">
      <a id="footer-contact-address" href={mapsUrl} target="_blank">
        {addressLines.map((line) => (
          <div class="footer-address-line">{line}</div>
        ))}
      </a>
      <div id="footer-contact-socials">
        <a class="footer-socials-line" href="https://twitter.com/kyndev" target="_blank">
          <svg
            class="footer-socials-line-svg"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              fill="#000"
              fill-rule="evenodd"
              d="M6.948 18.113a.75.75 0 0 1-1.06-1.06l9.885-9.886H8.65a.75.75 0 1 1 0-1.5h9.682v9.682a.75.75 0 0 1-1.5 0v-7.12l-9.884 9.884Z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span class="footer-socials-text">Twitter / X</span>
        </a>
        <a class="footer-socials-line" href="https://www.instagram.com/kyndev" target="_blank">
          <svg
            class="footer-socials-line-svg"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              fill="#000"
              fill-rule="evenodd"
              d="M6.948 18.113a.75.75 0 0 1-1.06-1.06l9.885-9.886H8.65a.75.75 0 1 1 0-1.5h9.682v9.682a.75.75 0 0 1-1.5 0v-7.12l-9.884 9.884Z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span class="footer-socials-text">Instagram</span>
        </a>
        <a class="footer-socials-line" href="https://www.linkedin.com/company/kyndev" target="_blank">
          <svg
            class="footer-socials-line-svg"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              fill="#000"
              fill-rule="evenodd"
              d="M6.948 18.113a.75.75 0 0 1-1.06-1.06l9.885-9.886H8.65a.75.75 0 1 1 0-1.5h9.682v9.682a.75.75 0 0 1-1.5 0v-7.12l-9.884 9.884Z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span class="footer-socials-text">LinkedIn</span>
        </a>
        <a class="footer-socials-line" href="https://github.com/thewaqaspro" target="_blank">
          <svg
            class="footer-socials-line-svg"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              fill="#000"
              fill-rule="evenodd"
              d="M6.948 18.113a.75.75 0 0 1-1.06-1.06l9.885-9.886H8.65a.75.75 0 1 1 0-1.5h9.682v9.682a.75.75 0 0 1-1.5 0v-7.12l-9.884 9.884Z"
              clip-rule="evenodd"
            ></path>
          </svg>
          <span class="footer-socials-text">GitHub</span>
        </a>
      </div>
      <div id="footer-contact-emails">
        <a class="footer-emails-line" href={`mailto:${emailGeneral}`}>{emailGeneral}</a>
        <a class="footer-emails-line" href={`mailto:${emailBusiness}`}>{emailBusiness}</a>
      </div>
    </div>
    <div id="footer-middle-texts">
      <div id="footer-texts-copyright">{copyright}</div>
      <div id="footer-texts-credit">{tagline}</div>
    </div>
  </div>
</div>

<script>
  import { initFooter } from './Footer.ts';
  initFooter();
</script>
