---
// src/components/Menu.astro
---

<div id="menu-overlay" aria-label="Fullscreen Navigation Menu">
  <div class="menu-header">
    <div class="menu-brand">
      <span class="mono-tag cyan">NAVIGATION PROTOCOL // V2.6</span>
    </div>
    <button id="menu-close" class="hud-btn" data-cursor="hover" aria-label="Close menu">
      <span>CLOSE [ ESC ]</span>
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <div class="menu-body">
    <nav class="menu-nav-links" aria-label="Site Pages">
      <a href="/" class="menu-nav-link" data-cursor="hover">
        <span class="link-index">01</span>
        <span class="link-name">HOME</span>
      </a>
      <a href="/projects" class="menu-nav-link" data-cursor="hover">
        <span class="link-index">02</span>
        <span class="link-name">WORK</span>
      </a>
      <a href="/services" class="menu-nav-link" data-cursor="hover">
        <span class="link-index">03</span>
        <span class="link-name">EXPERTISE</span>
      </a>
      <a href="/about" class="menu-nav-link" data-cursor="hover">
        <span class="link-index">04</span>
        <span class="link-name">ABOUT</span>
      </a>
      <a href="/contact" class="menu-nav-link" data-cursor="hover">
        <span class="link-index">05</span>
        <span class="link-name">CONTACT</span>
      </a>
    </nav>

    <div class="menu-side-meta">
      <div class="menu-meta-block">
        <h4>DIRECT INQUIRIES</h4>
        <a href="mailto:partners@lusion-systems.co">partners@lusion-systems.co</a>
        <a href="tel:+14158904812">+1 (415) 890-4812</a>
      </div>

      <div class="menu-meta-block">
        <h4>LOCATIONS & TIMEZONES</h4>
        <p>LONDON // UTC+1</p>
        <p>SAN FRANCISCO // UTC-7</p>
        <p>TOKYO // UTC+9</p>
      </div>

      <div class="menu-meta-block">
        <h4>COMMUNICATION CHANNELS</h4>
        <p><a href="https://github.com" target="_blank" rel="noopener">GITHUB // @LUSION-SYS</a></p>
        <p><a href="https://twitter.com" target="_blank" rel="noopener">X / TWITTER // @LUSION_SYS</a></p>
        <p><a href="https://linkedin.com" target="_blank" rel="noopener">LINKEDIN // LUSION-SYSTEMS</a></p>
      </div>
    </div>
  </div>

  <div class="menu-footer">
    <div class="mono-tag">
      ENGINEERING EXCELLENCE FOR GLOBAL VENTURES
    </div>
    <div class="mono-tag cyan">
      ASTRO 5 // THREE.JS R158 // GSAP // LENIS
    </div>
  </div>
</div>
