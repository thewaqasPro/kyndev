---
// src/components/Footer.astro
---

<footer class="site-footer">
  <!-- End Section CTA -->
  <section class="footer-cta-section container">
    <div class="cta-inner glass-panel">
      <div class="cta-header">
        <span class="mono-tag cyan">COLLABORATION INITIATIVE // 2026</span>
        <span class="mono-tag">RESPONSE WITHIN 24 HOURS</span>
      </div>

      <div class="cta-body">
        <h2 class="cta-heading">
          LET'S BUILD <br />
          <span class="highlight-cyan">YOUR SYSTEM.</span>
        </h2>
        <p class="cta-subtext">
          Whether you require a high-throughput SaaS web application, an enterprise Shopify Plus engine, 
          or an immersive 60fps WebGL digital flagship — our engineering core delivers without compromise.
        </p>

        <div class="cta-actions">
          <a href="/contact" class="btn-primary magnetic-btn" data-cursor="hover">
            <span>INITIATE PROJECT DIALOGUE</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M1 13L13 1M13 1H3M13 1V11" stroke="currentColor" stroke-width="1.75" />
            </svg>
          </a>
          <a href="mailto:partners@kyndev.com" class="btn-outline magnetic-btn" data-cursor="hover">
            <span>DIRECT RFQ DISPATCH</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Primary Footer Grid -->
  <div class="footer-grid-section container">
    <div class="footer-grid">
      <!-- Col 1: Newsletter -->
      <div class="footer-col newsletter-col">
        <div class="mono-tag cyan">DISPATCH // INSIGHTS & SYSTEMS</div>
        <p class="footer-desc">
          Quarterly architectural deep-dives on high-performance web engineering, GPU rendering, and distributed cloud backends.
        </p>
        <form class="newsletter-form" id="newsletter-form">
          <div class="newsletter-input-wrap">
            <input 
              type="email" 
              name="email" 
              id="newsletter-email" 
              placeholder="ENTER CORPORATE EMAIL..." 
              required 
              aria-label="Email address"
            />
            <button type="submit" class="newsletter-submit" aria-label="Subscribe to newsletter" data-cursor="hover">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>
          </div>
          <div class="newsletter-feedback" id="newsletter-feedback" aria-live="polite"></div>
        </form>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <div class="mono-tag">SYSTEM DIRECTORY</div>
        <ul class="footer-links">
          <li><a href="/" data-cursor="hover">HOME OVERVIEW</a></li>
          <li><a href="/projects" data-cursor="hover">CASE STUDIES & WORK</a></li>
          <li><a href="/services" data-cursor="hover">CORE EXPERTISE</a></li>
          <li><a href="/about" data-cursor="hover">STUDIO MANIFESTO</a></li>
          <li><a href="/contact" data-cursor="hover">INITIATE INQUIRY</a></li>
        </ul>
      </div>

      <!-- Col 3: Direct Inquiries -->
      <div class="footer-col">
        <div class="mono-tag">ENQUIRIES & OFFICES</div>
        <div class="contact-details">
          <p><span class="label">PRIMARY:</span> <a href="mailto:partners@kyndev.com">partners@kyndev.com</a></p>
          <p><span class="label">DIRECT:</span> <a href="tel:+14158904812">+1 (415) 890-4812</a></p>
          <p><span class="label">LONDON:</span> SHOREDITCH HIGH ST, E1 6JJ</p>
          <p><span class="label">SF:</span> MONTGOMERY ST, CA 94104</p>
        </div>
      </div>

      <!-- Col 4: Network & Socials -->
      <div class="footer-col">
        <div class="mono-tag">NETWORK & CODE</div>
        <ul class="footer-links">
          <li><a href="https://github.com/kyndev" target="_blank" rel="noopener" data-cursor="hover">GITHUB // @KYNDEV</a></li>
          <li><a href="https://twitter.com/kyndev" target="_blank" rel="noopener" data-cursor="hover">X / TWITTER // @KYNDEV</a></li>
          <li><a href="https://linkedin.com/company/kyndev" target="_blank" rel="noopener" data-cursor="hover">LINKEDIN // KYNDEV</a></li>
          <li><a href="https://read.cv" target="_blank" rel="noopener" data-cursor="hover">READ.CV // VERIFIED TEAM</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Metadata Bar -->
    <div class="footer-bottom-bar">
      <div class="footer-copy">
        © {new Date().getFullYear()} KYNDEV SYSTEMS LTD. ALL RIGHTS RESERVED.
      </div>
      <div class="footer-telemetry">
        <span id="utc-clock">UTC 00:00:00</span>
        <span class="hud-crosshair">//</span>
        <span>LATENCY: 18MS</span>
        <span class="hud-crosshair">//</span>
        <span>DEPLOYED ON NETLIFY EDGE</span>
      </div>
    </div>
  </div>
</footer>

<script>
  // Newsletter Form Handler
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const feedback = document.getElementById('newsletter-feedback');
  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = form.querySelector('input') as HTMLInputElement;
      if (input && input.value) {
        feedback.textContent = 'SUBSCRIPTION CONFIRMED // ENCRYPTED DISPATCH ACTIVE.';
        feedback.className = 'newsletter-feedback success';
        input.value = '';
      }
    });
  }

  // Live UTC Clock
  const clockEl = document.getElementById('utc-clock');
  function updateClock() {
    if (!clockEl) return;
    const now = new Date();
    const h = String(now.getUTCHours()).padStart(2, '0');
    const m = String(now.getUTCMinutes()).padStart(2, '0');
    const s = String(now.getUTCSeconds()).padStart(2, '0');
    clockEl.textContent = `UTC ${h}:${m}:${s}`;
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    margin-top: 6rem;
    padding-bottom: 3rem;
  }

  .footer-cta-section {
    margin-bottom: 6rem;
  }

  .cta-inner {
    padding: clamp(2.5rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    border-color: rgba(0, 240, 255, 0.2);
    background: radial-gradient(circle at 80% 20%, rgba(0, 240, 255, 0.08) 0%, rgba(12, 12, 18, 0.9) 70%);
  }

  .cta-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.25rem;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .highlight-cyan {
    color: var(--accent-cyan);
    text-shadow: 0 0 40px rgba(0, 240, 255, 0.3);
  }

  .cta-subtext {
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    color: var(--text-secondary);
    max-width: 720px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-grid-section {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.3fr 1.2fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .newsletter-input-wrap {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    transition: border-color 0.2s ease;
  }

  .newsletter-input-wrap:focus-within {
    border-color: var(--accent-cyan);
  }

  .newsletter-input-wrap input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.65rem 0.75rem;
  }

  .newsletter-input-wrap input::placeholder {
    color: var(--text-muted);
  }

  .newsletter-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .newsletter-submit:hover {
    color: var(--accent-cyan);
  }

  .newsletter-feedback {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  .newsletter-feedback.success {
    color: var(--accent-lime);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--accent-cyan);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .contact-details .label {
    color: var(--text-muted);
  }

  .contact-details a {
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .contact-details a:hover {
    color: var(--accent-cyan);
  }

  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .footer-telemetry {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
