---
// src/components/hub/HubHero.astro
import './hub.css';
import {
  hubHeroData,
  type HubHeroData,
  type HubFilterOption,
} from '../../data/pages/hub';

export type { HubFilterOption };

export interface Props extends Partial<HubHeroData> {}

const {
  eyebrow = hubHeroData.eyebrow,
  title = hubHeroData.title,
  description = hubHeroData.description,
  filters = hubHeroData.filters,
} = Astro.props;
---

<div id="hub-hero" class="section">
  <div class="hub-crosses">
    <div class="hub-cross"></div>
    <div class="hub-cross"></div>
  </div>

  <div id="hub-hero-eyebrow">
    <span class="live-dot"></span>
    <span>{eyebrow}</span>
  </div>

  <h1 id="hub-hero-title">{title}</h1>
  <p id="hub-hero-desc">{description}</p>

  <div class="hub-filters">
    {filters.map((filter) => (
      <button
        class={`hub-filter-btn ${filter.active ? 'active' : ''}`}
        data-filter={filter.id}
        type="button"
      >
        {filter.label}
      </button>
    ))}
  </div>
</div>
