---
// src/components/hub/HubCards.astro
import './hub.css';
import {
  hubCardsData,
  type HubCardsData,
  type HubCardItem,
  type HubGroupHeader,
} from '../../data/pages/hub';

export type { HubCardItem, HubGroupHeader };

export interface Props extends Partial<HubCardsData> {}

const {
  groupHeaders = hubCardsData.groupHeaders,
  items = hubCardsData.items,
} = Astro.props;

const getHeader = (grp: 'hero' | 'pages' | 'services' | 'cases') =>
  groupHeaders.find((h) => h.group === grp) || {
    title: '',
    badge: '',
  };
---

<div id="hub-content" class="section">
  <!-- Hero Section Prototypes Group -->
  <div class="hub-group" data-group="hero">
    <div class="hub-group-header">
      <h2 class="hub-group-title">{getHeader('hero').title}</h2>
      <span class="hub-group-badge">{getHeader('hero').badge}</span>
    </div>
    <div class="hub-cards-grid">
      {items.filter(i => i.group === 'hero').map(item => (
        <article class="hub-card" data-category={item.group}>
          <div>
            <div class="hub-card-header">
              <span class="hub-card-category">{item.category}</span>
              <span class={`hub-card-status ${item.status}`}>{item.statusLabel}</span>
            </div>
            <h3 class="hub-card-title">{item.title}</h3>
            <p class="hub-card-desc">{item.description}</p>
          </div>
          <div class="hub-card-footer">
            <div class="hub-card-tags">
              {item.tags.map(tag => (
                <span class="hub-card-tag">{tag}</span>
              ))}
            </div>
            <div class="hub-card-actions">
              <a href={item.route} class="hub-card-launch-btn" data-link-type="internal">
                <span>{item.ctaText}</span>
                <span>→</span>
              </a>
              <span class="hub-card-route">{item.route}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Flagship Pages Group -->
  <div class="hub-group" data-group="pages">
    <div class="hub-group-header">
      <h2 class="hub-group-title">{getHeader('pages').title}</h2>
      <span class="hub-group-badge">{getHeader('pages').badge}</span>
    </div>
    <div class="hub-cards-grid">
      {items.filter(i => i.group === 'pages').map(item => (
        <article class="hub-card" data-category={item.group}>
          <div>
            <div class="hub-card-header">
              <span class="hub-card-category">{item.category}</span>
              <span class={`hub-card-status ${item.status}`}>{item.statusLabel}</span>
            </div>
            <h3 class="hub-card-title">{item.title}</h3>
            <p class="hub-card-desc">{item.description}</p>
          </div>
          <div class="hub-card-footer">
            <div class="hub-card-tags">
              {item.tags.map(tag => (
                <span class="hub-card-tag">{tag}</span>
              ))}
            </div>
            <div class="hub-card-actions">
              <a href={item.route} class="hub-card-launch-btn" data-link-type="internal">
                <span>{item.ctaText}</span>
                <span>→</span>
              </a>
              <span class="hub-card-route">{item.route}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Services Suite Group -->
  <div class="hub-group" data-group="services">
    <div class="hub-group-header">
      <h2 class="hub-group-title">{getHeader('services').title}</h2>
      <span class="hub-group-badge">{getHeader('services').badge}</span>
    </div>
    <div class="hub-cards-grid">
      {items.filter(i => i.group === 'services').map(item => (
        <article class={`hub-card ${item.compact ? 'hub-card-compact' : ''}`} data-category={item.group}>
          <div>
            <div class="hub-card-header">
              <span class="hub-card-category">{item.category}</span>
              <span class={`hub-card-status ${item.status}`}>{item.statusLabel}</span>
            </div>
            <h3 class="hub-card-title">{item.title}</h3>
            <p class="hub-card-desc">{item.description}</p>
          </div>
          <div class="hub-card-footer">
            <div class="hub-card-tags">
              {item.tags.map(tag => (
                <span class="hub-card-tag">{tag}</span>
              ))}
            </div>
            <div class="hub-card-actions">
              <a href={item.route} class="hub-card-launch-btn" data-link-type="internal">
                <span>{item.ctaText}</span>
                <span>→</span>
              </a>
              <span class="hub-card-route">{item.route}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Case Studies Group -->
  <div class="hub-group" data-group="cases">
    <div class="hub-group-header">
      <h2 class="hub-group-title">{getHeader('cases').title}</h2>
      <span class="hub-group-badge">{getHeader('cases').badge}</span>
    </div>
    <div class="hub-cards-grid">
      {items.filter(i => i.group === 'cases').map(item => (
        <article class={`hub-card ${item.compact ? 'hub-card-compact' : ''}`} data-category={item.group}>
          <div>
            <div class="hub-card-header">
              <span class="hub-card-category">{item.category}</span>
              <span class={`hub-card-status ${item.status}`}>{item.statusLabel}</span>
            </div>
            <h3 class="hub-card-title">{item.title}</h3>
            <p class="hub-card-desc">{item.description}</p>
          </div>
          <div class="hub-card-footer">
            <div class="hub-card-tags">
              {item.tags.map(tag => (
                <span class="hub-card-tag">{tag}</span>
              ))}
            </div>
            <div class="hub-card-actions">
              <a href={item.route} class="hub-card-launch-btn" data-link-type="internal">
                <span>{item.ctaText}</span>
                <span>→</span>
              </a>
              <span class="hub-card-route">{item.route}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  // Interactive Filter Tabs
  const filterBtns = document.querySelectorAll('.hub-filter-btn');
  const groups = document.querySelectorAll('.hub-group');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      groups.forEach(group => {
        const groupType = group.getAttribute('data-group');
        if (filter === 'all' || filter === groupType) {
          (group as HTMLElement).style.display = 'flex';
        } else {
          (group as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
