---
import './aboutCapability.css';

interface CapabilityCard {
  title: string;
  letter: string;
  items: string[];
}

const capabilities: CapabilityCard[] = [
  {
    title: 'Strategy',
    letter: 's',
    items: [
      'Digital Experience Strategy',
      'Technology Strategy',
      'Creative Direction',
      'Discovery',
      'Research'
    ]
  },
  {
    title: 'Creative',
    letter: 'c',
    items: [
      'Art Direction',
      'UX/UI Design',
      'Motion Design',
      'Interactive Design',
      'Illustration'
    ]
  },
  {
    title: 'Tech',
    letter: 't',
    items: [
      'WebGL Development',
      'Front End Development',
      'Unity/Unreal',
      'Interactive Installations',
      'AR and VR Experiences'
    ]
  },
  {
    title: 'Production',
    letter: 'P',
    items: [
      'Procedural Modeling',
      '3D Asset Creation',
      '3D Optimization',
      'Animation',
      '3D Pipeline Development'
    ]
  }
];
---

<div id="about-capability" class="section">
  <div id="about-capability-title">
    <div id="about-capability-title-line-1">AREA OF</div>
    <div id="about-capability-title-line-2">EXPERTISE</div>
  </div>
  <div id="about-capability-subheader">
    <div id="about-capability-subheader-text">Multidisciplinary expertise across strategy, creative, technology, and production.</div>
    <div id="about-capability-subheader-cards">
      <div class="about-capability-subheader-card">s</div>
      <div class="about-capability-subheader-card">d</div>
      <div class="about-capability-subheader-card">t</div>
      <div class="about-capability-subheader-card">3</div>
    </div>
  </div>
  <div id="about-capability-cards-wrapper">
    <div id="about-capability-cards">
      {capabilities.map((cap, index) => (
        <div class="about-capability-card">
          {index === 0 ? (
            <>
              <div class="about-capability-card-front">
                <div class="about-capability-card-header">
                  <p class="about-capability-card-header-text">{cap.title}</p>
                  <div class="about-capability-card-header-letter">{cap.letter}</div>
                </div>
                <ul class="about-capability-list">
                  {cap.items.map((item) => (
                    <li class="about-capability-list-item">{item}</li>
                  ))}
                </ul>
                <div class="about-capability-card-header">
                  <p class="about-capability-card-header-text">{cap.title}</p>
                  <div class="about-capability-card-header-letter">{cap.letter}</div>
                </div>
              </div>
              <div class="about-capability-card-back"></div>
            </>
          ) : (
            <>
              <div class="about-capability-card-back"></div>
              <div class="about-capability-card-front">
                <div class="about-capability-card-header">
                  <p class="about-capability-card-header-text">{cap.title}</p>
                  <div class="about-capability-card-header-letter">{cap.letter}</div>
                </div>
                <ul class="about-capability-list">
                  {cap.items.map((item) => (
                    <li class="about-capability-list-item">{item}</li>
                  ))}
                </ul>
                <div class="about-capability-card-header">
                  <p class="about-capability-card-header-text">{cap.title}</p>
                  <div class="about-capability-card-header-letter">{cap.letter}</div>
                </div>
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import { initAboutCapability } from './aboutCapability.js';
  initAboutCapability();
</script>
