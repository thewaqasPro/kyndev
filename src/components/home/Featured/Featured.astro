---
// src/components/home/Featured/Featured.astro
import './featured.css';
import {
  homeFeaturedData,
  type HomeFeaturedData,
  type FeaturedProjectItem,
} from '../../../data/pages/home';

export type ProjectItem = FeaturedProjectItem;

export interface Props extends Partial<HomeFeaturedData> {}

const {
  projects = homeFeaturedData.projects,
  title = homeFeaturedData.title,
  disclaimer = homeFeaturedData.disclaimer,
  ctaText = homeFeaturedData.ctaText,
  ctaLink = homeFeaturedData.ctaLink,
} = Astro.props;
---

<div id="home-featured" class="section">
  <div id="home-featured-title-top">
    <div id="home-featured-title-wrapper">
      <h4 id="home-featured-title">{title}</h4>
    </div>
    <div id="home-featured-disclaimer">{disclaimer}</div>
  </div>
  <div class="project-list">
    {projects.map((project) => (
      <a
        class="project-item project-type-website"
        href={project.href}
        data-id={project.id}
        data-color-bg={project.colorBg}
        data-color-text={project.colorText}
        data-color-shadow={project.colorShadow}
      >
        <div class="project-item-main">
          <div class="project-item-image"></div>
        </div>
        <div class="project-item-footer">
          <div class="project-item-line-1">{project.tags}</div>
          <div class="project-item-line-2">
            <div class="project-item-line-2-icon"></div>
            <div class="project-item-line-2-inner">{project.title}</div>
          </div>
        </div>
      </a>
    ))}
  </div>
  <a id="home-featured-cta" href={ctaLink} target="_blank">
    <span id="home-featured-cta-dot"></span>
    <span id="home-featured-cta-text">{ctaText}</span>
    <span id="home-featured-cta-arrow">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        fill="none"
        viewBox="0 0 16 16"
      >
        <path
          stroke="#fff"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M2.343 8h11.314m0 0L8.673 3.016M13.657 8l-4.984 4.984"
        ></path>
      </svg>
    </span>
  </a>
</div>
