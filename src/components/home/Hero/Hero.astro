---
// src/components/Hero/Hero.astro
import './hero.css';
import { homeHeroData, type HomeHeroData } from '../../../data/pages/home/hero';

interface Props extends Partial<HomeHeroData> {}

const {
  title = homeHeroData.title,
  scrollText = homeHeroData.scrollText,
} = Astro.props;
---

<div id="home-hero" class="section">
  <h1 id="home-hero-title">{title}</h1>
  <div id="home-hero-visual-container" aria-label="Interactive 3D Balloons Playground"></div>
  <div id="home-hero-scroll-container">
    <div id="home-hero-scroll-container-crosses">
      <div class="home-hero-scroll-container-cross"></div>
      <div class="home-hero-scroll-container-cross"></div>
      <div class="home-hero-scroll-container-cross"></div>
      <div class="home-hero-scroll-container-cross"></div>
    </div>
    <div id="home-hero-scroll">{scrollText}</div>
  </div>
</div>

<script>
  import { initHero } from './Hero.ts';
  initHero();
</script>
