---
// src/components/home/HeroTools/HeroTools.astro
import "./heroTools.css";
import { heroToolsData, type HeroToolsData } from "../../../data/pages/home";

interface Props extends Partial<HeroToolsData> {
  layout?: "full" | "split";
  showReturnBanner?: boolean;
}

const {
  title = heroToolsData.title,
  titleAccent = heroToolsData.titleAccent,
  tag = heroToolsData.tag,
  description = heroToolsData.description,
  ctaText = heroToolsData.ctaText,
  ctaLink = heroToolsData.ctaLink,
  scatterButtonText = heroToolsData.scatterButtonText,
  defaultHud = heroToolsData.defaultHud,
  layout = "full",
  showReturnBanner = true,
} = Astro.props;
---

<div id="home-hero-tools" class="section">
  <!-- Bounded Deck Stage Container: Supports optional 40/60 split or full deck -->
  <div id="hero-tools-deck" class={`deck-${layout}`} data-layout={layout}>
    {showReturnBanner && (
      <div id="hero-tools-preview-banner">
        <span class="pulse-dot"></span>
        <span>3D Marketing Tools</span>
        <span>•</span>
        <div class="hero-tools-layout-toggle" role="group" aria-label="Layout mode switch">
          <button type="button" class="layout-toggle-btn active" data-set-layout="full">Full Deck</button>
          <button type="button" class="layout-toggle-btn" data-set-layout="split">40/60 Split</button>
        </div>
        <span>•</span>
        <a href="/hub" data-link-type="internal">Hub</a>
        <span>•</span>
        <a href="/" data-link-type="internal">Balloons Hero →</a>
      </div>
    )}

    <!-- Left Column: Title, Description, Actions & HUD Card (Active in 40/60 Split, overlays in Full Deck) -->
    <div id="hero-tools-col-left">
      <div id="hero-tools-header">
        <span id="hero-tools-tag">{tag}</span>
        <h1 id="hero-tools-title">
          {title} <span class="accent">{titleAccent}</span>.
        </h1>
        <p id="hero-tools-description">
          {description}
        </p>
      </div>

      <!-- Action buttons in split mode -->
      <div id="hero-tools-split-actions">
        <a href={ctaLink} class="hero-tools-btn" data-link-type="internal">
          {ctaText}
        </a>
        <button id="hero-tools-split-impulse-btn" class="hero-tools-btn hero-tools-btn-secondary" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          {scatterButtonText}
        </button>
      </div>
    </div>

    <!-- Interactive Tool HUD Card -->
    <div id="hero-tools-hud">
      <div id="hero-tools-hud-icon">{defaultHud.icon}</div>
      <div id="hero-tools-hud-content">
        <h3 id="hero-tools-hud-name">{defaultHud.name}</h3>
        <span id="hero-tools-hud-sub">{defaultHud.subtitle}</span>
        <span id="hero-tools-hud-hint">{defaultHud.hint}</span>
      </div>
    </div>

    <!-- Right Column: 60% Dedicated 3D Interactive Stage in Split, Full Bleed in Full Deck -->
    <div id="hero-tools-col-right">
      <!-- 3D Physics Canvas Container -->
      <div id="hero-tools-canvas-container" aria-label="Interactive 3D Marketing Tools Simulation"></div>

      <!-- Bottom Right Controls (visible in full deck mode) -->
      <div id="hero-tools-controls">
        <button id="hero-tools-impulse-btn" class="hero-tools-btn" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          {scatterButtonText}
        </button>
        <a href={ctaLink} class="hero-tools-btn hero-tools-btn-secondary" data-link-type="internal">
          {ctaText}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { heroToolsSection } from "../../../scripts/runtime/sections/HeroToolsSection.js";
  if (typeof window !== "undefined") {
    const init = () => {
      heroToolsSection.preInit();
      heroToolsSection.init();
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
    document.addEventListener("astro:page-load", init);
  }
</script>
