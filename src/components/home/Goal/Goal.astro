---
// src/components/home/Goal/Goal.astro
import './goal.css';
import { homeGoalData, type HomeGoalData } from '../../../data/pages/home';

export interface Props extends Partial<HomeGoalData> {}

const {
  title = homeGoalData.title,
  paragraphs = homeGoalData.paragraphs,
  tunnelLines = homeGoalData.tunnelLines,
} = Astro.props;
---

<div id="home-goal" class="section">
  <div id="home-goal-context">
    <div id="home-goal-context-inner">
      <div id="home-goal-title">{title}</div>
      <div id="home-goal-texts">
        {paragraphs.map((p) => (
          <div class="home-goal-texts-paragraph">{p}</div>
        ))}
      </div>
      <div id="home-goal-image-in-outer">
        <div id="home-goal-image-in-inner">
          <div id="home-goal-image-in"></div>
        </div>
      </div>
      <div id="home-goal-tunnel-title">
        {tunnelLines.map((line) => (
          <div class="home-goal-tunnel-title-line">{line}</div>
        ))}
      </div>
      <div id="home-goal-image-out-outer">
        <div id="home-goal-image-out-inner">
          <div id="home-goal-image-out"></div>
        </div>
      </div>
    </div>
  </div>
</div>
