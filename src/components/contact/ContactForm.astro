---
// src/components/contact/ContactForm.astro
import './contactForm.css';

interface Props {
  email?: string;
  phone?: string;
  address?: string;
}

const {
  email = 'hello@kyndstudio.com',
  phone = '+1 (778) 594-5459',
  address = 'Rossland, B.C (HQ) & Bristol, UK',
} = Astro.props;

const servicesOptions = [
  'Web Development',
  'Web Design',
  'Social Media Marketing',
  'SEO',
  'Sales Funnels',
  'PPC Advertising',
];
---

<div id="contact-content" class="section">
  <!-- Left Column: Interactive Form -->
  <div class="contact-form-column">
    <form id="kynd-contact-form" class="contact-form">
      <div class="contact-field-group">
        <label class="contact-label" for="contact-name">Your Name *</label>
        <input
          id="contact-name"
          class="contact-input"
          type="text"
          name="name"
          placeholder="Jane Doe"
          required
        />
      </div>

      <div class="contact-field-group">
        <label class="contact-label" for="contact-email">Your Email *</label>
        <input
          id="contact-email"
          class="contact-input"
          type="email"
          name="email"
          placeholder="jane@company.com"
          required
        />
      </div>

      <div class="contact-field-group">
        <label class="contact-label">Services Required</label>
        <div class="contact-services-pills">
          {servicesOptions.map((service, idx) => (
            <label class="contact-service-pill">
              <input type="checkbox" name="services" value={service} checked={idx === 0} />
              <span>{service}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="contact-field-group">
        <label class="contact-label" for="contact-budget">Estimated Budget</label>
        <select id="contact-budget" class="contact-select" name="budget">
          <option value="10k-25k">$10,000 - $25,000</option>
          <option value="25k-50k" selected>$25,000 - $50,000</option>
          <option value="50k-100k">$50,000 - $100,000</option>
          <option value="100k+">$100,000+</option>
        </select>
      </div>

      <div class="contact-field-group">
        <label class="contact-label" for="contact-message">Project Overview *</label>
        <textarea
          id="contact-message"
          class="contact-textarea"
          name="message"
          rows="4"
          placeholder="Tell us about your brand, timeline, and vision..."
          required
        ></textarea>
      </div>

      <button type="submit" class="contact-submit-btn">
        <span>Send Inquiry</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          fill="none"
          viewBox="0 0 16 16"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M2.343 8h11.314m0 0-4.984 4.984M13.657 8 8.673 3.016"
          ></path>
        </svg>
      </button>
    </form>
  </div>

  <!-- Right Column: Studio Information -->
  <div class="contact-info-column">
    <div class="contact-status-badge">
      <span class="badge-dot"></span>
      <span>Available for Q2/Q3 Projects</span>
    </div>

    <div class="contact-info-card">
      <div class="contact-info-block">
        <span class="contact-info-block-header">Direct Inquiries //</span>
        <a class="contact-info-block-val" href={`mailto:${email}`}>{email}</a>
      </div>

      <div class="contact-info-block">
        <span class="contact-info-block-header">Phone //</span>
        <a class="contact-info-block-val" href="tel:+17785945459">{phone}</a>
      </div>

      <div class="contact-info-block">
        <span class="contact-info-block-header">Locations //</span>
        <div class="contact-info-block-val">{address}</div>
      </div>

      <div class="contact-socials-grid">
        <a class="contact-social-link" href="https://twitter.com/kyndev" target="_blank" rel="noreferrer">
          <span>Twitter / X</span>
          <span>↗</span>
        </a>
        <a class="contact-social-link" href="https://instagram.com/kyndev" target="_blank" rel="noreferrer">
          <span>Instagram</span>
          <span>↗</span>
        </a>
        <a class="contact-social-link" href="https://linkedin.com/company/kyndev" target="_blank" rel="noreferrer">
          <span>LinkedIn</span>
          <span>↗</span>
        </a>
        <a class="contact-social-link" href="https://github.com/kyndev" target="_blank" rel="noreferrer">
          <span>GitHub</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const contactForm = document.getElementById('kynd-contact-form');
  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you for reaching out! The KYNDEV team will get back to you shortly.');
    });
  }
</script>
