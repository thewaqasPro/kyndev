---
// src/components/contact/ContactHero.astro
import './contactHero.css';
import { contactHeroData, type ContactHeroData } from '../../data/pages/contact';

export interface Props extends Partial<ContactHeroData> {}

const {
  eyebrow = contactHeroData.eyebrow,
  title = contactHeroData.title,
  description = contactHeroData.description,
} = Astro.props;
---

<div id="contact-hero" class="section">
  <div class="contact-hero-crosses">
    <div class="contact-hero-cross"></div>
    <div class="contact-hero-cross"></div>
  </div>

  <div id="contact-hero-eyebrow">
    <span class="dot"></span>
    <span>{eyebrow}</span>
  </div>

  <h1 id="contact-hero-title">{title}</h1>
  <p id="contact-hero-desc">{description}</p>
</div>
