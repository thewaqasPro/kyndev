---
// src/components/ScrollHUD.astro
---

<!-- Lateral Scroll Progress Bar -->
<div id="scroll-indicator" aria-hidden="true">
  <div id="scroll-indicator-bar"></div>
</div>

<!-- Bottom Left Scroll Telemetry HUD -->
<div class="scroll-nav-hud" aria-hidden="true">
  <span class="hud-crosshair">+</span>
  <span id="hud-coord-y">Y: 0000PX</span>
  <span class="hud-crosshair">//</span>
  <span id="hud-scroll-pct">0%</span>
  <span class="hud-crosshair">//</span>
  <span class="hud-fps">60 FPS</span>
</div>

<!-- Corner Crosshair Accent Markers -->
<div class="hud-corner top-left" aria-hidden="true">+</div>
<div class="hud-corner top-right" aria-hidden="true">+</div>
<div class="hud-corner bottom-right" aria-hidden="true">
  <span class="mono-tag cyan">EST. 2026 // LUSION ARCHITECTURE</span>
</div>

<style>
  .hud-corner {
    position: fixed;
    z-index: 40;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    opacity: 0.5;
  }

  .hud-corner.top-left {
    top: 1.5rem;
    left: 1.5rem;
  }

  .hud-corner.top-right {
    top: 1.5rem;
    right: 1.5rem;
  }

  .hud-corner.bottom-right {
    bottom: clamp(1.25rem, 3vw, 2.5rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    opacity: 0.8;
  }

  .hud-fps {
    color: var(--accent-lime);
  }

  @media (max-width: 768px) {
    .hud-corner,
    .scroll-nav-hud {
      display: none;
    }
  }
</style>
