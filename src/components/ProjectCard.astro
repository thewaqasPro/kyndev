---
// src/components/ProjectCard.astro
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const formattedIndex = String(index + 1).padStart(2, '0');
---

<article class="project-card glass-panel" style={`--accent-item: ${project.accentColor};`}>
  <!-- Card Header -->
  <div class="card-header">
    <div class="card-index-wrap">
      <span class="card-index mono-tag">[{formattedIndex}]</span>
      <span class="mono-tag cyan">{project.category}</span>
    </div>
    <div class="card-metrics-chip">
      <span class="metric-label">{project.metrics[0].label}:</span>
      <span class="metric-value">{project.metrics[0].value}</span>
    </div>
  </div>

  <!-- Interactive Visual Stage -->
  <div class="card-stage" data-cursor="view" data-cursor-text="VIEW REEL">
    <div class="stage-gradient"></div>
    <div class="stage-grid-lines"></div>

    <!-- Center Interactive Hologram Preview -->
    <div class="stage-visual">
      <div class="hologram-ring outer"></div>
      <div class="hologram-ring inner"></div>
      <div class="hologram-core">
        <span class="hologram-id">{project.slug.toUpperCase()}</span>
      </div>
    </div>

    <!-- Watch Reel Trigger Floating Pill -->
    <button 
      type="button" 
      class="reel-trigger-btn"
      data-video-trigger
      data-project-title={project.title}
      data-project-client={project.client}
      data-project-duration={project.reelDuration}
      aria-label={`Watch video reel for ${project.title}`}
    >
      <span class="play-icon">▶</span>
      <span>WATCH REEL [{project.reelDuration}]</span>
    </button>
  </div>

  <!-- Card Body & Details -->
  <div class="card-body">
    <div class="card-title-group">
      <h3 class="card-title">
        <a href={`/projects/${project.slug}`} data-cursor="hover">
          {project.title}
        </a>
      </h3>
      <p class="card-tagline">{project.tagline}</p>
    </div>

    <div class="card-tech-chips">
      {project.techStack.slice(0, 4).map((tech) => (
        <span class="tech-chip">{tech}</span>
      ))}
    </div>

    <div class="card-footer">
      <span class="mono-tag">{project.client} // {project.year}</span>
      <a href={`/projects/${project.slug}`} class="case-study-link" data-cursor="hover">
        <span>EXPLORE CASE STUDY</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M1 11L11 1M11 1H3M11 1V9" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    gap: 1.5rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent-item, var(--accent-cyan));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 240, 255, 0.12);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .card-index-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .card-metrics-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .metric-label {
    color: var(--text-muted);
  }

  .metric-value {
    color: var(--accent-item, var(--accent-cyan));
    font-weight: 600;
  }

  .card-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 8px;
    overflow: hidden;
    background: #09090e;
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(0, 240, 255, 0.08) 0%, transparent 70%);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .project-card:hover .stage-gradient {
    opacity: 1;
    background: radial-gradient(circle at 50% 50%, rgba(0, 240, 255, 0.18) 0%, transparent 75%);
  }

  .stage-grid-lines {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  .stage-visual {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hologram-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed var(--accent-item, var(--accent-cyan));
    opacity: 0.4;
    transition: transform 0.6s ease, opacity 0.6s ease;
  }

  .hologram-ring.outer {
    width: 100%;
    height: 100%;
    animation: spinClockwise 16s linear infinite;
  }

  .hologram-ring.inner {
    width: 65%;
    height: 65%;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.2);
    animation: spinCounterClockwise 12s linear infinite;
  }

  .project-card:hover .hologram-ring {
    opacity: 0.9;
    transform: scale(1.1);
  }

  .hologram-core {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hologram-id {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--text-primary);
  }

  @keyframes spinClockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spinCounterClockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  .reel-trigger-btn {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    background: rgba(10, 10, 14, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    transition: all 0.25s ease;
    z-index: 5;
  }

  .reel-trigger-btn:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.15);
  }

  .play-icon {
    font-size: 0.65rem;
    color: var(--accent-cyan);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .card-title a {
    transition: color 0.25s ease;
  }

  .card-title a:hover {
    color: var(--accent-item, var(--accent-cyan));
  }

  .card-tagline {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .card-tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.25rem 0.6rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    color: var(--text-secondary);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .case-study-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--accent-item, var(--accent-cyan));
    transition: gap 0.2s ease;
  }

  .case-study-link:hover {
    gap: 0.75rem;
  }
</style>
